+    if document.is_null() || identity.is_null() || length == 0 || length > 65 {
+        return std::ptr::null();
+    }
+    let Ok(document) = (unsafe { std::ffi::CStr::from_ptr(document) }).to_str() else {
+        return std::ptr::null();
+    };
+    let identity = unsafe { std::slice::from_raw_parts(identity, length) };
+    avian_verified_host::publish_services(document, identity)
+        .ok()
+        .and_then(|result| std::ffi::CString::new(result).ok())
+        .map_or(std::ptr::null(), |result| result.into_raw())
+}
