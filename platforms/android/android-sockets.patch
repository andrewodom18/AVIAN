+//! Android underlay binding is delegated to the owning VpnService before traffic leaves a socket.
+use std::{
+    ffi::CString,
+    io,
+    net::{IpAddr, SocketAddr},
+    os::fd::AsRawFd,
+    sync::RwLock,
+};
+
+pub type SocketCallback = unsafe extern "C" fn(
+    i32,
+    *const std::ffi::c_char,
+    *const std::ffi::c_char,
+    *const std::ffi::c_char,
+) -> i32;
+static CALLBACK: RwLock<Option<SocketCallback>> = RwLock::new(None);
+
+pub fn set_callback(callback: Option<SocketCallback>) {
+    if let Ok(mut current) = CALLBACK.write() {
+        *current = callback;
+    }
+}
+
+pub fn prepare(
+    socket: &impl AsRawFd,
+    destination: SocketAddr,
+    source: Option<IpAddr>,
+    interface: Option<&str>,
+) -> io::Result<()> {
+    let callback = CALLBACK
+        .read()
+        .map_err(|_| io::Error::other("Android socket callback lock failed"))?
+        .ok_or_else(|| {
+            io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "Android socket host is unavailable",
+            )
+        })?;
+    let destination = CString::new(destination.to_string()).map_err(io::Error::other)?;
+    let source = CString::new(
+        source
+            .map(|address| address.to_string())
+            .unwrap_or_default(),
+    )
+    .map_err(io::Error::other)?;
+    let interface = CString::new(interface.unwrap_or_default()).map_err(io::Error::other)?;
+    // The host borrows the descriptor and strings only for this synchronous call.
+    // Java duplicates the descriptor before adopting it, so it cannot close the engine socket.
+    if unsafe {
+        callback(
+            socket.as_raw_fd(),
+            destination.as_ptr(),
+            source.as_ptr(),
+            interface.as_ptr(),
+        )
+    } != 0
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "Android rejected socket protection or Network binding",
+        ));
+    }
+    Ok(())
+}
