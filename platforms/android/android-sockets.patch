+/// # Safety
+/// Configuration is NUL-terminated; credential points to exactly length initialized bytes.
+#[cfg(target_os = "android")]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn avian_android_start_verified(
+    configuration: *const std::ffi::c_char,
+    credential: *const u8,
+    length: usize,
+) -> i32 {
+    if configuration.is_null() || credential.is_null() || length == 0 || length > 65 {
+        return -1;
+    }
+    let Ok(configuration) = (unsafe { std::ffi::CStr::from_ptr(configuration) }).to_str() else {
+        return -1;
+    };
+    let credential = unsafe { std::slice::from_raw_parts(credential, length) };
+    avian_verified_host::start(configuration, credential).map_or(-1, |_| 0)
+}
