+pub unsafe extern "C" fn avian_android_service_page(
+    after: *const std::ffi::c_char,
+    limit: usize,
+) -> *const std::ffi::c_char {
+    let after = if after.is_null() {
+        None
+    } else {
+        let Ok(after) = (unsafe { std::ffi::CStr::from_ptr(after) }).to_str() else {
+            return std::ptr::null();
+        };
+        Some(after)
+    };
+    avian_verified_host::service_page(after, limit)
+        .ok()
+        .and_then(|result| std::ffi::CString::new(result).ok())
+        .map_or(std::ptr::null(), |result| result.into_raw())
+}
