{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avian.local/schemas/validation-report-v1.schema.json",
  "title": "AVIAN mesh simulator validation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "limitations", "scenarios", "passed"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "model": { "type": "string", "minLength": 1 },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "passed": { "type": "boolean" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "config", "metrics", "passed", "event_digest_sha256", "events"],
        "properties": {
          "name": { "type": "string" },
          "passed": { "type": "boolean" },
          "event_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "config": {
            "type": "object",
            "required": ["aircraft", "seed", "direct_peer_limit", "messages_per_node", "failure_percent"]
          },
          "metrics": {
            "type": "object",
            "required": ["nodes", "links", "max_degree", "self_links", "duplicate_links", "messages_attempted", "messages_delivered", "messages_dropped", "delivery_ratio", "convergence_p50_ms", "convergence_p95_ms", "partitioned_nodes", "recovery_ms", "recovered_connected"]
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["message_id", "from", "to", "hop", "scheduled_at_ms", "outcome"],
              "properties": { "outcome": { "enum": ["forwarded", "dropped", "delivered"] } }
            }
          }
        }
      }
    }
  }
}
