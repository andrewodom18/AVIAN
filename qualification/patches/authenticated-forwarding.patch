+/// Preserve the configured packet budget after end-to-end and hop encryption.
+fn forwarding_interface_mtu(configured: u32, payload_encryption: bool, authenticated_hops: bool, ipv6: bool) -> Result<u32, Error> {
+    let overhead = if payload_encryption { 20 } else { 0 }
+        + if authenticated_hops { 40 } else { 0 };
+    let effective = configured.checked_sub(overhead)
+        .ok_or_else(|| Error::AnyhowError(anyhow::anyhow!("MTU is smaller than encryption overhead")))?;
+    if effective == 0 || (ipv6 && effective < 1280) {
+        return Err(Error::AnyhowError(anyhow::anyhow!("effective forwarding MTU is too small for the enabled IP version")));
+    }
+    Ok(effective)
+}
