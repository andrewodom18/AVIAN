@@ -0,0 +1,289 @@
+//! Per-connection Noise transport envelope. The complete forwarding frame is authenticated.
+use crate::tunnel::packet_def::{PEER_MANAGER_HEADER_SIZE, PeerManagerHeader, ZCPacket};
+use snow::StatelessTransportState;
+use std::sync::Mutex;
+use zerocopy::FromBytes;
+
+const HOP_ENVELOPE: u8 = 250;
+const MAXIMUM_PLAINTEXT: usize = 65_459;
+const REPLAY_WINDOW: u64 = 128;
+
+#[derive(Default, Debug)]
+struct ReplayWindow {
+    highest: Option<u64>,
+    seen: u128,
+}
+impl ReplayWindow {
+    fn accepts(&self, nonce: u64) -> bool {
+        match self.highest {
+            None => true,
+            Some(highest) if nonce > highest => true,
+            Some(highest) => {
+                let distance = highest - nonce;
+                distance < REPLAY_WINDOW && self.seen & (1u128 << distance) == 0
+            }
+        }
+    }
+    fn record(&mut self, nonce: u64) {
+        match self.highest {
+            None => {
+                self.highest = Some(nonce);
+                self.seen = 1;
+            }
+            Some(highest) if nonce > highest => {
+                let distance = nonce - highest;
+                self.seen = if distance >= REPLAY_WINDOW {
+                    1
+                } else {
+                    (self.seen << distance) | 1
+                };
+                self.highest = Some(nonce);
+            }
+            Some(highest) => self.seen |= 1u128 << (highest - nonce),
+        }
+    }
+}
+
+pub(super) struct HopTransport {
+    noise: StatelessTransportState,
+    next_nonce: Mutex<u64>,
+    replay: Mutex<ReplayWindow>,
+}
+impl std::fmt::Debug for HopTransport {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("HopTransport")
+    }
+}
+impl HopTransport {
+    pub(super) fn new(noise: StatelessTransportState) -> Self {
+        Self {
+            noise,
+            next_nonce: Mutex::new(0),
+            replay: Mutex::new(ReplayWindow::default()),
+        }
+    }
+    pub(super) fn seal(&self, packet: ZCPacket) -> Result<ZCPacket, String> {
+        let plaintext = packet.tunnel_payload();
+        if plaintext.len() < PEER_MANAGER_HEADER_SIZE || plaintext.len() > MAXIMUM_PLAINTEXT {
+            return Err("forwarding frame exceeds Noise envelope bounds".into());
+        }
+        let mut nonce_guard = self.next_nonce.lock().unwrap();
+        let nonce = *nonce_guard;
+        *nonce_guard = nonce.checked_add(1).ok_or("hop nonce exhausted")?;
+        let mut ciphertext = vec![0u8; plaintext.len() + 16];
+        let length = self
+            .noise
+            .write_message(nonce, plaintext, &mut ciphertext)
+            .map_err(|error| format!("hop encryption failed: {error}"))?;
+        let mut body = Vec::with_capacity(8 + length);
+        body.extend_from_slice(&nonce.to_le_bytes());
+        body.extend_from_slice(&ciphertext[..length]);
+        let mut envelope = ZCPacket::new_with_payload(&body);
+        // The outer header is framing only; no routing fields are consumed before authentication.
+        envelope.fill_peer_manager_hdr(0, 0, HOP_ENVELOPE);
+        Ok(envelope)
+    }
+    pub(super) fn open(&self, envelope: ZCPacket) -> Result<ZCPacket, String> {
+        let header = envelope
+            .peer_manager_header()
+            .ok_or("missing hop envelope header")?;
+        let payload = envelope.payload();
+        if header.packet_type != HOP_ENVELOPE
+            || header.from_peer_id.get() != 0
+            || header.to_peer_id.get() != 0
+            || header.flags != 0
+            || header.forward_counter != 1
+            || header.len.get() as usize != payload.len()
+            || payload.len() < 8 + 16 + PEER_MANAGER_HEADER_SIZE
+            || payload.len() > 8 + MAXIMUM_PLAINTEXT + 16
+        {
+            return Err("invalid or unsealed forwarding envelope".into());
+        }
+        let nonce = u64::from_le_bytes(payload[..8].try_into().unwrap());
+        let mut replay = self.replay.lock().unwrap();
+        if !replay.accepts(nonce) {
+            return Err("replayed forwarding envelope".into());
+        }
+        let mut plaintext = vec![0u8; payload.len() - 8];
+        let length = self
+            .noise
+            .read_message(nonce, &payload[8..], &mut plaintext)
+            .map_err(|_| "forwarding envelope authentication failed")?;
+        if length < PEER_MANAGER_HEADER_SIZE {
+            return Err("truncated forwarding frame".into());
+        }
+        let header = PeerManagerHeader::read_from(&plaintext[..PEER_MANAGER_HEADER_SIZE])
+            .ok_or("invalid forwarding header")?;
+        let mut packet = ZCPacket::new_with_payload(&plaintext[PEER_MANAGER_HEADER_SIZE..length]);
+        *packet.mut_peer_manager_header().unwrap() = header;
+        replay.record(nonce);
+        Ok(packet)
+    }
+}
