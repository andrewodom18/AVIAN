+    #[test]
+    fn avian_hop_mtu_accounts_for_envelopes_and_ipv6_minimum() {
+        assert_eq!(forwarding_interface_mtu(1380, true, true, true).unwrap(), 1320);
+        assert_eq!(forwarding_interface_mtu(1380, true, false, true).unwrap(), 1360);
+        assert_eq!(forwarding_interface_mtu(1380, false, true, true).unwrap(), 1340);
+        assert!(forwarding_interface_mtu(40, true, true, false).is_err());
+        assert!(forwarding_interface_mtu(1339, true, true, true).is_err());
+        assert_eq!(forwarding_interface_mtu(1340, true, true, true).unwrap(), 1280);
+    }
