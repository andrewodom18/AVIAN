+        );
+        assert!(destination.open(first.clone()).is_ok());
+        assert!(destination.open(first).is_err());
+        assert!(destination.open(second).is_ok());
+        assert!(source.open(destination.seal(packet()).unwrap()).is_ok());
+    }
+    #[test]
+    fn avian_hop_rejects_tamper_without_consuming_nonce() {
+        let (source, destination) = pair();
+        let sealed = source.seal(packet()).unwrap();
+        for offset in [0, 8, 16, sealed.payload().len() - 1] {
+            let mut changed = sealed.clone();
+            changed.mut_payload()[offset] ^= 1;
+            assert!(destination.open(changed).is_err());
+        }
+        let mut wrong_type = sealed.clone();
+        wrong_type.mut_peer_manager_header().unwrap().packet_type = PacketType::Ping as u8;
+        assert!(destination.open(wrong_type).is_err());
+        let mut wrong_header = sealed.clone();
+        wrong_header
+            .mut_peer_manager_header()
+            .unwrap()
+            .set_latency_first(true);
+        assert!(destination.open(wrong_header).is_err());
+        assert!(
+            destination
+                .open(sealed)
+                .unwrap()
+                .peer_manager_header()
+                .unwrap()
+                .is_latency_first()
+        );
+        assert!(destination.open(packet()).is_err());
+    }
+    #[test]
+    fn avian_hop_connection_and_direction_keys_are_distinct() {
+        let (source, destination) = pair();
+        let (_, stranger) = pair();
+        let sealed = source.seal(packet()).unwrap();
+        assert!(stranger.open(sealed.clone()).is_err());
+        assert!(source.open(sealed.clone()).is_err());
+        assert!(destination.open(sealed).is_ok());
+    }
+    #[test]
+    fn avian_hop_relay_preserves_inner_frame_and_reseals() {
+        let (source, relay_inbound) = pair();
+        let (relay_outbound, destination) = pair();
+        let mut inner = packet();
+        inner.mut_peer_manager_header().unwrap().set_encrypted(true);
+        let relayed = relay_inbound
+            .open(source.seal(inner.clone()).unwrap())
+            .unwrap();
+        assert_eq!(relayed.tunnel_payload(), inner.tunnel_payload());
+        let resealed = relay_outbound.seal(relayed).unwrap();
+        assert!(relay_inbound.open(resealed.clone()).is_err());
+        assert_eq!(
+            destination.open(resealed).unwrap().tunnel_payload(),
+            inner.tunnel_payload()
+        );
+    }
+    #[test]
+    fn avian_hop_replay_window_and_message_bounds() {
+        let (source, destination) = pair();
+        let old = source.seal(packet()).unwrap();
+        for _ in 0..REPLAY_WINDOW {
+            destination.open(source.seal(packet()).unwrap()).unwrap();
+        }
+        assert!(destination.open(old).is_err());
+        let mut oversized = ZCPacket::new_with_payload(&vec![0; MAXIMUM_PLAINTEXT]);
+        oversized.fill_peer_manager_hdr(10, 30, PacketType::Data as u8);
+        assert!(source.seal(oversized).is_err());
+        *source.next_nonce.lock().unwrap() = u64::MAX;
+        assert!(source.seal(packet()).is_err());
+    }
+    #[test]
+    fn avian_hop_rejects_legacy_noise_prologue() {
+        let parameters: snow::params::NoiseParams =
+            "Noise_XX_25519_ChaChaPoly_SHA256".parse().unwrap();
+        let key = snow::Builder::new(parameters.clone())
+            .generate_keypair()
+            .unwrap();
+        let mut legacy = snow::Builder::new(parameters.clone())
+            .prologue(b"easytier-peerconn-noise")
+            .unwrap()
+            .local_private_key(&key.private)
+            .unwrap()
+            .build_initiator()
+            .unwrap();
+        let mut candidate = snow::Builder::new(parameters)
+            .prologue(b"avian-peerconn-noise-hop-v1")
+            .unwrap()
+            .local_private_key(&key.private)
+            .unwrap()
+            .build_responder()
+            .unwrap();
+        let mut wire = vec![0; 1024];
+        let mut clear = vec![0; 1024];
+        let length = legacy.write_message(&[], &mut wire).unwrap();
+        candidate.read_message(&wire[..length], &mut clear).unwrap();
+        let length = candidate.write_message(&[], &mut wire).unwrap();
+        assert!(legacy.read_message(&wire[..length], &mut clear).is_err());
+    }
+}
