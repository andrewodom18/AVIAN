diff --git a/easytier/src/peers/traffic_policy.rs b/easytier/src/peers/traffic_policy.rs
new file mode 100644
--- /dev/null
+++ b/easytier/src/peers/traffic_policy.rs
@@ -0,0 +1,185 @@
+//! Local connection policy; the hop envelope authenticates the inner class byte.
+use crate::{
+    proto::common::TunnelInfo,
+    tunnel::packet_def::{PacketType, ZCPacket},
+};
+use std::{collections::BTreeSet, net::IpAddr, sync::OnceLock};
+
+pub(crate) const CONTROL: u8 = 1;
+pub(crate) const TELEMETRY: u8 = 2;
+pub(crate) const VIDEO: u8 = 3;
+pub(crate) const BULK: u8 = 4;
+
+#[derive(Default, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct LocalPolicy {
+    #[serde(default)]
+    metered_addresses: BTreeSet<IpAddr>,
+    #[serde(default)]
+    allow_metered_video: bool,
+    #[serde(default)]
+    allow_metered_bulk: bool,
+}
+
+fn policy() -> &'static Result<LocalPolicy, String> {
+    static POLICY: OnceLock<Result<LocalPolicy, String>> = OnceLock::new();
+    POLICY.get_or_init(|| match std::env::var("AVIAN_TRAFFIC_POLICY") {
+        Ok(encoded) => serde_json::from_str(&encoded).map_err(|error| error.to_string()),
+        Err(std::env::VarError::NotPresent) => Ok(LocalPolicy::default()),
+        Err(_) => Err("invalid traffic policy encoding".into()),
+    })
+}
+
+/// Classify only locally originated plaintext. Fragmented/unknown traffic is bulk.
+pub(crate) fn classify_ip_packet(packet: &[u8]) -> u8 {
+    let Some(first) = packet.first() else {
+        return BULK;
+    };
+    let (traffic_bits, protocol, offset) = match first >> 4 {
+        4 if packet.len() >= 20 => {
+            let header_length = usize::from(first & 15) * 4;
+            if header_length < 20
+                || packet.len() < header_length
+                || packet[6] & 0x3f != 0
+                || packet[7] != 0
+            {
+                return BULK;
+            }
+            (packet[1], packet[9], header_length)
+        }
+        6 if packet.len() >= 40 => (((first & 15) << 4) | (packet[1] >> 4), packet[6], 40),
+        _ => return BULK,
+    };
+    if traffic_bits >> 2 == 40 {
+        return CONTROL;
+    } // DSCP CS5; ignore ECN.
+    if traffic_bits >> 2 == 32 || protocol == 1 || protocol == 58 {
+        return TELEMETRY;
+    }
+    if protocol == 17 && packet.len() >= offset + 8 {
+        let destination = u16::from_be_bytes([packet[offset + 2], packet[offset + 3]]);
+        let source = u16::from_be_bytes([packet[offset], packet[offset + 1]]);
+        if [source, destination]
+            .iter()
+            .any(|port| matches!(port, 8000 | 8001))
+        {
+            return VIDEO;
+        }
+    }
+    BULK
+}
+
+fn permitted(policy: &LocalPolicy, class: u8, local_address: Option<IpAddr>) -> bool {
+    if !(CONTROL..=BULK).contains(&class) {
+        return false;
+    }
+    let Some(address) = local_address else {
+        return false;
+    };
+    if !policy.metered_addresses.contains(&address) {
+        return true;
+    }
+    match class {
+        CONTROL | TELEMETRY => true,
+        VIDEO => policy.allow_metered_video,
+        BULK => policy.allow_metered_bulk,
+        _ => false,
+    }
+}
+
+pub(crate) fn permits_connection(packet: &ZCPacket, tunnel: Option<&TunnelInfo>) -> bool {
+    let Some(header) = packet.peer_manager_header() else {
+        return false;
+    };
+    if header.packet_type != PacketType::Data as u8 {
+        return true;
+    }
+    let Ok(policy) = policy() else {
+        return false;
+    };
+    let class = if header.avian_traffic_class() == 0 {
+        BULK
+    } else {
+        header.avian_traffic_class()
+    };
+    let local_address = tunnel
+        .and_then(|info| info.local_addr.as_ref())
+        .and_then(|address| url::Url::parse(&address.url).ok())
+        .and_then(|address| {
+            address
+                .host_str()
+                .map(|host| host.trim_matches(['[', ']']).to_owned())
+        })
+        .and_then(|host| host.parse::<IpAddr>().ok())
+        .filter(|address| !address.is_unspecified());
+    // In the default unmetered mode, non-IP internal tunnels remain usable.
+    if local_address.is_none() && policy.metered_addresses.is_empty() {
+        return (CONTROL..=BULK).contains(&class);
+    }
+    permitted(policy, class, local_address)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn avian_policy_rejects_authentication_only_peer() {
+        let parameters: snow::params::NoiseParams =
+            "Noise_XX_25519_ChaChaPoly_SHA256".parse().unwrap();
+        let key = snow::Builder::new(parameters.clone())
+            .generate_keypair()
+            .unwrap();
+        let mut old_peer = snow::Builder::new(parameters.clone())
+            .prologue(b"avian-peerconn-noise-hop-v1")
+            .unwrap()
+            .local_private_key(&key.private)
+            .unwrap()
+            .build_initiator()
+            .unwrap();
+        let mut policy_peer = snow::Builder::new(parameters)
+            .prologue(b"avian-peerconn-noise-hop-policy-v1")
+            .unwrap()
+            .local_private_key(&key.private)
+            .unwrap()
+            .build_responder()
+            .unwrap();
+        let mut wire = vec![0; 1024];
+        let mut plaintext = vec![0; 1024];
+        let length = old_peer.write_message(&[], &mut wire).unwrap();
+        policy_peer
+            .read_message(&wire[..length], &mut plaintext)
+            .unwrap();
+        let length = policy_peer.write_message(&[], &mut wire).unwrap();
+        assert!(
+            old_peer
+                .read_message(&wire[..length], &mut plaintext)
+                .is_err()
+        );
+    }
+
+    #[test]
+    fn avian_policy_classification_and_metered_restrictions() {
+        let mut packet = vec![0u8; 28];
+        packet[0] = 0x45;
+        packet[9] = 17;
+        packet[22..24].copy_from_slice(&8000u16.to_be_bytes());
+        assert_eq!(classify_ip_packet(&packet), VIDEO);
+        packet[1] = 0xa3;
+        assert_eq!(classify_ip_packet(&packet), CONTROL);
+        packet[1] = 0x80;
+        assert_eq!(classify_ip_packet(&packet), TELEMETRY);
+        packet[6] = 0x20;
+        assert_eq!(classify_ip_packet(&packet), BULK);
+        let address: IpAddr = "172.30.0.2".parse().unwrap();
+        let mut policy = LocalPolicy::default();
+        policy.metered_addresses.insert(address);
+        assert!(permitted(&policy, CONTROL, Some(address)));
+        assert!(permitted(&policy, TELEMETRY, Some(address)));
+        assert!(!permitted(&policy, VIDEO, Some(address)));
+        assert!(!permitted(&policy, BULK, Some(address)));
+        assert!(!permitted(&policy, 99, Some(address)));
+        policy.allow_metered_video = true;
+        assert!(permitted(&policy, VIDEO, Some(address)));
+        assert!(!permitted(&policy, BULK, Some(address)));
+    }
+}
