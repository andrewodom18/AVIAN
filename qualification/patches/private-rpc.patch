+//! Per-instance authenticated and encrypted local administration transport.
+use crate::{
+    proto::common::TunnelInfo,
+    tunnel::{
+        SplitTunnel, StreamItem, Tunnel, TunnelConnector, TunnelError, TunnelListener,
+        filter::{TunnelFilter, TunnelWithFilter},
+        packet_def::{PacketType, ZCPacket, ZCPacketType},
+    },
+};
+use bytes::BytesMut;
+use futures::{SinkExt, StreamExt};
+use snow::{Builder, TransportState, params::NoiseParams};
+use std::{
+    fs::OpenOptions,
+    io::Read,
+    path::Path,
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+use tokio::task::JoinSet;
+use zeroize::{Zeroize, Zeroizing};
+
+const MAGIC: &[u8] = b"AVIAN_PRIVATE_RPC_V1:";
+const PROLOGUE: &[u8] = b"avian-private-admin-rpc-v1";
+const PATTERN: &str = "Noise_NNpsk0_25519_ChaChaPoly_SHA256";
+const HANDSHAKE_TIMEOUT: Duration = Duration::from_secs(3);
+const MAXIMUM_PENDING_HANDSHAKES: usize = 16;
+const MAXIMUM_PLAINTEXT_FRAME: usize = 65_519;
+type SharedKey = Arc<Zeroizing<[u8; 32]>>;
+
+fn authentication_failed() -> TunnelError {
+    TunnelError::InvalidPacket("private RPC authentication failed".into())
+}
+
+fn protected_token(path: &Path) -> Result<SharedKey, TunnelError> {
+    let metadata = std::fs::symlink_metadata(path).map_err(|_| authentication_failed())?;
+    let parent = path
+        .parent()
+        .filter(|parent| !parent.as_os_str().is_empty())
+        .unwrap_or(Path::new("."));
+    let parent_metadata = std::fs::symlink_metadata(parent).map_err(|_| authentication_failed())?;
+    if !metadata.is_file()
+        || !parent_metadata.is_dir()
+        || metadata.file_type().is_symlink()
+        || parent_metadata.file_type().is_symlink()
+    {
+        return Err(authentication_failed());
+    }
+    let mut options = OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::{MetadataExt, OpenOptionsExt, PermissionsExt};
+        let user = nix::unistd::geteuid().as_raw();
+        if metadata.uid() != user
+            || parent_metadata.uid() != user
+            || metadata.nlink() > 1
+            || metadata.permissions().mode() & 0o077 != 0
+            || parent_metadata.permissions().mode() & 0o022 != 0
+        {
+            return Err(authentication_failed());
+        }
+        options.custom_flags(nix::libc::O_NOFOLLOW | nix::libc::O_NONBLOCK);
+    }
+    #[cfg(windows)]
+    {
+        verify_windows_owner_acl(path)?;
+        use std::os::windows::fs::OpenOptionsExt;
+        options.custom_flags(0x0020_0000); // Open a reparse point itself rather than following it.
+    }
+    #[cfg(not(any(unix, windows)))]
+    return Err(authentication_failed());
+    let file = options.open(path).map_err(|_| authentication_failed())?;
+    let opened = file.metadata().map_err(|_| authentication_failed())?;
+    if !opened.is_file() {
+        return Err(authentication_failed());
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::{MetadataExt, PermissionsExt};
+        if opened.uid() != metadata.uid()
+            || opened.ino() != metadata.ino()
+            || opened.dev() != metadata.dev()
+            || opened.nlink() > 1
+            || opened.permissions().mode() & 0o077 != 0
+        {
+            return Err(authentication_failed());
+        }
+    }
+    #[cfg(windows)]
+    {
+        use std::os::windows::fs::MetadataExt;
+        if opened.file_attributes() & 0x400 != 0 {
+            return Err(authentication_failed());
+        }
+    }
+    let mut encoded = Zeroizing::new(String::new());
+    file.take(66)
+        .read_to_string(&mut encoded)
+        .map_err(|_| authentication_failed())?;
+    let text = encoded.strip_suffix('\n').unwrap_or(&encoded);
+    if text.len() != 64
+        || !text
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+    {
+        return Err(authentication_failed());
+    }
+    let mut key = Zeroizing::new([0u8; 32]);
+    for (index, pair) in text.as_bytes().chunks_exact(2).enumerate() {
+        let pair = std::str::from_utf8(pair).map_err(|_| authentication_failed())?;
+        key[index] = u8::from_str_radix(pair, 16).map_err(|_| authentication_failed())?;
+    }
+    if key.iter().all(|byte| *byte == 0) {
+        return Err(authentication_failed());
+    }
+    Ok(Arc::new(key))
+}
+
+#[cfg(windows)]
+fn verify_windows_owner_acl(path: &Path) -> Result<(), TunnelError> {
+    use std::{
+        io::Write,
+        process::{Command, Stdio},
+        time::Instant,
+    };
+    let root = std::env::var_os("SystemRoot").ok_or_else(authentication_failed)?;
+    let backend =
+        std::path::PathBuf::from(root).join("System32/WindowsPowerShell/v1.0/powershell.exe");
+    if !backend.is_absolute() {
+        return Err(authentication_failed());
+    }
+    let mut child = Command::new(backend)
+        .args([
+            "-NoLogo",
+            "-NoProfile",
+            "-NonInteractive",
+            "-Command",
+            include_str!("private_rpc_acl.ps1"),
+        ])
+        .stdin(Stdio::piped())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+        .map_err(|_| authentication_failed())?;
+    let payload = serde_json::to_vec(
+        &serde_json::json!({"path": path.to_str().ok_or_else(authentication_failed)?}),
+    )
+    .map_err(|_| authentication_failed())?;
+    let mut input = child.stdin.take().ok_or_else(authentication_failed)?;
+    let writer = std::thread::spawn(move || input.write_all(&payload));
+    let started = Instant::now();
+    loop {
+        match child.try_wait() {
+            Ok(Some(status)) => {
+                let written = writer.join().is_ok_and(|result| result.is_ok());
+                return if status.success() && written {
+                    Ok(())
+                } else {
+                    Err(authentication_failed())
+                };
+            }
+            Ok(None) if started.elapsed() < Duration::from_secs(10) => {
+                std::thread::sleep(Duration::from_millis(20))
+            }
+            _ => {
+                let _ = child.kill();
+                let _ = child.wait();
+                let _ = writer.join();
+                return Err(authentication_failed());
+            }
+        }
+    }
+}
+
+enum Protection {
+    Disabled,
+    Enabled(SharedKey),
+    Invalid,
+}
+impl Protection {
+    fn from_environment() -> Self {
+        match std::env::var_os("AVIAN_RPC_TOKEN_FILE") {
+            None => Self::Disabled,
+            Some(path) => match protected_token(Path::new(&path)) {
+                Ok(key) => Self::Enabled(key),
+                Err(_) => Self::Invalid,
+            },
+        }
+    }
+}
+
+struct RawTunnel {
+    info: Option<TunnelInfo>,
+    split: Mutex<Option<SplitTunnel>>,
+}
+impl Tunnel for RawTunnel {
+    fn split(&self) -> SplitTunnel {
+        self.split
+            .lock()
+            .unwrap()
+            .take()
+            .expect("private RPC tunnel splits once")
+    }
+    fn info(&self) -> Option<TunnelInfo> {
+        self.info.clone()
+    }
+}
+struct EncryptedFrames {
+    state: Mutex<TransportState>,
+}
+impl TunnelFilter for EncryptedFrames {
+    type FilterOutput = ();
+    fn before_send(&self, packet: ZCPacket) -> Option<ZCPacket> {
+        let plaintext = packet.tunnel_payload();
+        if plaintext.len() > MAXIMUM_PLAINTEXT_FRAME {
+            return None;
+        }
+        let mut ciphertext = vec![0u8; plaintext.len() + 16];
+        let length = self
+            .state
+            .lock()
+            .ok()?
+            .write_message(plaintext, &mut ciphertext)
+            .ok()?;
+        Some(control_packet(&ciphertext[..length]))
+    }
+    fn after_received(&self, packet: StreamItem) -> Option<StreamItem> {
+        let packet = match packet {
+            Ok(packet) => packet,
+            Err(_) => return Some(Err(authentication_failed())),
+        };
+        if packet.peer_manager_header().is_none() || packet.payload().len() > 65_535 {
+            return Some(Err(authentication_failed()));
+        }
+        let mut plaintext = Zeroizing::new(vec![0u8; packet.payload().len()]);
+        let length = match self
+            .state
+            .lock()
+            .ok()?
+            .read_message(packet.payload(), &mut plaintext)
+        {
+            Ok(length) => length,
+            Err(_) => return Some(Err(authentication_failed())),
+        };
+        let packet = ZCPacket::new_from_buf(
+            BytesMut::from(&plaintext[..length]),
+            ZCPacketType::DummyTunnel,
+        );
+        if packet.peer_manager_header().is_none() {
+            return Some(Err(authentication_failed()));
+        }
+        Some(Ok(packet))
+    }
+    fn filter_output(&self) {}
+}
+fn control_packet(payload: &[u8]) -> ZCPacket {
+    let mut packet = ZCPacket::new_with_payload(payload);
+    packet.fill_peer_manager_hdr(0, 0, PacketType::Data as u8);
+    packet
+}
+async fn receive_handshake(
+    stream: &mut std::pin::Pin<Box<dyn crate::tunnel::ZCPacketStream>>,
+) -> Result<Vec<u8>, TunnelError> {
+    let packet = match stream.next().await {
+        Some(Ok(packet)) => packet,
+        _ => return Err(authentication_failed()),
+    };
+    if packet.peer_manager_header().is_none() || packet.payload().len() > 1024 {
+        return Err(authentication_failed());
+    }
+    packet
+        .payload()
+        .strip_prefix(MAGIC)
+        .map(|payload| payload.to_vec())
+        .ok_or_else(authentication_failed)
+}
+async fn upgrade(
+    tunnel: Box<dyn Tunnel>,
+    key: SharedKey,
+    initiator: bool,
+) -> Result<Box<dyn Tunnel>, TunnelError> {
+    tokio::time::timeout(HANDSHAKE_TIMEOUT, async move {
+        let params: NoiseParams = PATTERN.parse().map_err(|_| authentication_failed())?;
+        let builder = Builder::new(params)
+            .prologue(PROLOGUE)
+            .map_err(|_| authentication_failed())?
+            .psk(0, key.as_ref())
+            .map_err(|_| authentication_failed())?;
+        let mut state = if initiator {
+            builder.build_initiator()
+        } else {
+            builder.build_responder()
+        }
+        .map_err(|_| authentication_failed())?;
+        let info = tunnel.info();
+        let (mut stream, mut sink) = tunnel.split();
+        let mut message = [0u8; 1024];
+        let mut plaintext = [0u8; 1024];
+        if !initiator {
+            let incoming = receive_handshake(&mut stream).await?;
+            state
+                .read_message(&incoming, &mut plaintext)
+                .map_err(|_| authentication_failed())?;
+        }
+        let length = state
+            .write_message(&[], &mut message)
+            .map_err(|_| authentication_failed())?;
+        let mut outgoing = Vec::with_capacity(MAGIC.len() + length);
+        outgoing.extend_from_slice(MAGIC);
+        outgoing.extend_from_slice(&message[..length]);
+        sink.send(control_packet(&outgoing))
+            .await
+            .map_err(|_| authentication_failed())?;
+        if initiator {
+            let incoming = receive_handshake(&mut stream).await?;
+            state
+                .read_message(&incoming, &mut plaintext)
+                .map_err(|_| authentication_failed())?;
+        }
+        let state = state
+            .into_transport_mode()
+            .map_err(|_| authentication_failed())?;
+        Ok(Box::new(TunnelWithFilter::new(
+            RawTunnel {
+                info,
+                split: Mutex::new(Some((stream, sink))),
+            },
+            EncryptedFrames {
+                state: Mutex::new(state),
+            },
+        )) as Box<dyn Tunnel>)
+    })
+    .await
+    .map_err(|_| authentication_failed())?
+}
+
+pub struct PrivateRpcListener<L: TunnelListener> {
+    listener: L,
+    protection: Protection,
+    pending: JoinSet<Result<Box<dyn Tunnel>, TunnelError>>,
+}
+impl<L: TunnelListener> PrivateRpcListener<L> {
+    pub fn new(listener: L) -> Self {
+        Self {
+            listener,
+            protection: Protection::from_environment(),
+            pending: JoinSet::new(),
+        }
+    }
+}
+#[async_trait::async_trait]
+impl<L: TunnelListener + 'static> TunnelListener for PrivateRpcListener<L> {
+    async fn listen(&mut self) -> Result<(), TunnelError> {
+        if matches!(self.protection, Protection::Invalid) {
+            return Err(authentication_failed());
+        }
+        self.listener.listen().await
+    }
+    async fn accept(&mut self) -> Result<Box<dyn Tunnel>, TunnelError> {
+        let key = match &self.protection {
+            Protection::Disabled => return self.listener.accept().await,
+            Protection::Invalid => return Err(authentication_failed()),
+            Protection::Enabled(key) => Arc::clone(key),
+        };
+        loop {
+            tokio::select! {
+                result = self.pending.join_next(), if !self.pending.is_empty() => {
+                    if let Some(Ok(Ok(tunnel))) = result { return Ok(tunnel); }
+                }
+                accepted = self.listener.accept(), if self.pending.len() < MAXIMUM_PENDING_HANDSHAKES => {
+                    let tunnel = accepted?;
+                    let key = Arc::clone(&key);
+                    self.pending.spawn(async move { upgrade(tunnel, key, false).await });
+                }
+            }
+        }
+    }
+    fn local_url(&self) -> url::Url {
+        self.listener.local_url()
+    }
+}
+
+pub struct PrivateRpcConnector<C: TunnelConnector> {
+    connector: C,
+    protection: Protection,
+}
+impl<C: TunnelConnector> PrivateRpcConnector<C> {
+    pub fn new(connector: C) -> Self {
+        Self {
+            connector,
+            protection: Protection::from_environment(),
+        }
+    }
+}
+#[async_trait::async_trait]
+impl<C: TunnelConnector> TunnelConnector for PrivateRpcConnector<C> {
+    async fn connect(&mut self) -> Result<Box<dyn Tunnel>, TunnelError> {
+        match &self.protection {
+            Protection::Disabled => self.connector.connect().await,
+            Protection::Invalid => Err(authentication_failed()),
+            Protection::Enabled(key) => {
+                upgrade(self.connector.connect().await?, Arc::clone(key), true).await
+            }
+        }
+    }
+    fn remote_url(&self) -> url::Url {
+        self.connector.remote_url()
+    }
+}
+
+pub fn redacted_node_config(configuration: String) -> String {
+    let configuration = Zeroizing::new(configuration);
+    let Ok(mut document) = configuration.parse::<toml::Value>() else {
+        return String::new();
+    };
+    let mut safe = toml::map::Map::new();
+    for field in ["instance_name", "instance_id", "hostname", "ipv4", "ipv6"] {
+        if let Some(value) = document.get(field) {
+            safe.insert(field.into(), value.clone());
+        }
+    }
+    let mut secure = toml::map::Map::new();
+    for field in ["enabled", "local_public_key"] {
+        if let Some(value) = document
+            .get("secure_mode")
+            .and_then(|secure| secure.get(field))
+        {
+            secure.insert(field.into(), value.clone());
+        }
+    }
+    safe.insert("secure_mode".into(), toml::Value::Table(secure));
+    erase_strings(&mut document);
+    toml::to_string(&toml::Value::Table(safe)).unwrap_or_default()
+}
+fn erase_strings(document: &mut toml::Value) {
+    match document {
+        toml::Value::String(value) => value.zeroize(),
+        toml::Value::Array(values) => values.iter_mut().for_each(erase_strings),
+        toml::Value::Table(values) => values
+            .iter_mut()
+            .for_each(|(_, value)| erase_strings(value)),
+        _ => (),
+    }
+}
