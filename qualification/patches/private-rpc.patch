+#[cfg(test)]
+mod management_tests {
+    use super::*;
+    use crate::{
+        proto::{
+            rpc_impl::{
+                RpcController,
+                standalone::{StandAloneClient, StandAloneServer},
+            },
+            tests::{
+                Greeting, GreetingClientFactory, GreetingServer, SayGoodbyeRequest,
+                SayGoodbyeResponse, SayHelloRequest, SayHelloResponse,
+            },
+        },
+        tunnel::tcp::{TcpTunnelConnector, TcpTunnelListener},
+    };
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    #[derive(Clone)]
+    struct ManagementService(Arc<AtomicUsize>);
+    #[async_trait::async_trait]
+    impl Greeting for ManagementService {
+        type Controller = RpcController;
+        async fn say_hello(
+            &self,
+            _: RpcController,
+            input: SayHelloRequest,
+        ) -> crate::proto::rpc_types::error::Result<SayHelloResponse> {
+            self.0.fetch_add(1, Ordering::SeqCst);
+            Ok(SayHelloResponse {
+                greeting: input.name,
+            })
+        }
+        async fn say_goodbye(
+            &self,
+            _: RpcController,
+            input: SayGoodbyeRequest,
+        ) -> crate::proto::rpc_types::error::Result<SayGoodbyeResponse> {
+            self.0.fetch_add(1, Ordering::SeqCst);
+            Ok(SayGoodbyeResponse {
+                greeting: input.name,
+            })
+        }
+    }
+    fn connector(url: url::Url, value: u8) -> PrivateRpcConnector<TcpTunnelConnector> {
+        PrivateRpcConnector {
+            connector: TcpTunnelConnector::new(url),
+            protection: Protection::Enabled(Arc::new(Zeroizing::new([value; 32]))),
+        }
+    }
+    #[tokio::test]
+    async fn avian_private_rpc_rejects_unauthorized_management_before_side_effects() {
+        let mutations = Arc::new(AtomicUsize::new(0));
+        let mut listener = TcpTunnelListener::new("tcp://127.0.0.1:0".parse().unwrap());
+        listener.listen().await.unwrap();
+        let address = listener.local_url();
+        let listener = PrivateRpcListener {
+            listener,
+            protection: Protection::Enabled(Arc::new(Zeroizing::new([7; 32]))),
+            pending: JoinSet::new(),
+        };
+        let mut server = StandAloneServer::new(listener);
+        server.registry().register(
+            GreetingServer::new(ManagementService(Arc::clone(&mutations))),
+            "",
+        );
+        server.serve().await.unwrap();
+        let mut wrong = StandAloneClient::new(connector(address.clone(), 8));
+        assert!(
+            wrong
+                .scoped_client::<GreetingClientFactory<RpcController>>(String::new())
+                .await
+                .is_err()
+        );
+        assert_eq!(mutations.load(Ordering::SeqCst), 0);
+        let mut legacy = StandAloneClient::new(TcpTunnelConnector::new(address.clone()));
+        let remote = legacy
+            .scoped_client::<GreetingClientFactory<RpcController>>(String::new())
+            .await
+            .unwrap();
+        let result = tokio::time::timeout(
+            Duration::from_millis(300),
+            remote.say_hello(
+                RpcController::default(),
+                SayHelloRequest {
+                    name: "unauthorized operation".into(),
+                },
+            ),
+        )
+        .await;
+        assert!(!matches!(result, Ok(Ok(_))));
+        assert_eq!(mutations.load(Ordering::SeqCst), 0);
+        let mut authorized = StandAloneClient::new(connector(address, 7));
+        let remote = authorized
+            .scoped_client::<GreetingClientFactory<RpcController>>(String::new())
+            .await
+            .unwrap();
+        let result = tokio::time::timeout(
+            Duration::from_secs(2),
+            remote.say_hello(
+                RpcController::default(),
+                SayHelloRequest {
+                    name: "authorized operation".into(),
+                },
+            ),
+        )
+        .await
+        .unwrap()
+        .unwrap();
+        assert_eq!(result.greeting, "authorized operation");
+        assert_eq!(mutations.load(Ordering::SeqCst), 1);
+    }
+}
