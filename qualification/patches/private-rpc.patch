@@ -0,0 +1,24 @@
+$ErrorActionPreference = 'Stop'
+[Console]::InputEncoding = New-Object System.Text.UTF8Encoding($false)
+try {
+    $path = ([Console]::In.ReadToEnd() | ConvertFrom-Json).path
+    $identity = [System.Security.Principal.WindowsIdentity]::GetCurrent().User.Value
+    foreach ($candidate in @($path, [System.IO.Path]::GetDirectoryName($path))) {
+        $current = [System.IO.Path]::GetFullPath($candidate)
+        while ($current) {
+            if (([System.IO.File]::GetAttributes($current) -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) { throw 'Reparse point' }
+            $current = [System.IO.Path]::GetDirectoryName($current)
+        }
+        $acl = Get-Acl -LiteralPath $candidate
+        if ($acl.GetOwner([System.Security.Principal.SecurityIdentifier]).Value -ne $identity -or -not $acl.AreAccessRulesProtected) { throw 'Unprotected owner' }
+        $allowed = $false
+        foreach ($rule in $acl.GetAccessRules($true, $true, [System.Security.Principal.SecurityIdentifier])) {
+            if ($rule.AccessControlType -eq [System.Security.AccessControl.AccessControlType]::Allow) {
+                if ($rule.IdentityReference.Value -ne $identity) { throw 'Foreign access' }
+                $allowed = $true
+            }
+        }
+        if (-not $allowed) { throw 'Missing owner access' }
+    }
+    exit 0
+} catch { exit 1 }
