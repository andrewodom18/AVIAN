+
+    fn transport_states() -> (EncryptedFrames, EncryptedFrames) {
+        let secret = [7u8; 32];
+        let params: NoiseParams = PATTERN.parse().unwrap();
+        let mut client = Builder::new(params.clone())
+            .prologue(PROLOGUE)
+            .unwrap()
+            .psk(0, &secret)
+            .unwrap()
+            .build_initiator()
+            .unwrap();
+        let mut server = Builder::new(params)
+            .prologue(PROLOGUE)
+            .unwrap()
+            .psk(0, &secret)
+            .unwrap()
+            .build_responder()
+            .unwrap();
+        let mut message = [0u8; 1024];
+        let mut plaintext = [0u8; 1024];
+        let length = client.write_message(&[], &mut message).unwrap();
+        assert!(
+            !message[..length]
+                .windows(secret.len())
+                .any(|window| window == secret)
+        );
+        server
+            .read_message(&message[..length], &mut plaintext)
+            .unwrap();
+        let length = server.write_message(&[], &mut message).unwrap();
+        client
+            .read_message(&message[..length], &mut plaintext)
+            .unwrap();
+        (
+            EncryptedFrames {
+                state: Mutex::new(client.into_transport_mode().unwrap()),
+            },
+            EncryptedFrames {
+                state: Mutex::new(server.into_transport_mode().unwrap()),
+            },
+        )
+    }
+
+    #[test]
+    fn avian_private_rpc_replay_tampering_and_cross_connection_frames_are_rejected() {
+        let (client, server) = transport_states();
+        let packet = client
+            .before_send(control_packet(b"private operation contents"))
+            .unwrap();
+        assert!(
+            !packet
+                .payload()
+                .windows(b"private operation contents".len())
+                .any(|window| window == b"private operation contents")
+        );
+        assert!(server.after_received(Ok(packet.clone())).unwrap().is_ok());
+        assert!(server.after_received(Ok(packet.clone())).unwrap().is_err());
+        let (_, other_server) = transport_states();
+        assert!(other_server.after_received(Ok(packet)).unwrap().is_err());
+        let mut tampered = client
+            .before_send(control_packet(b"next operation"))
+            .unwrap();
+        tampered.mut_payload()[0] ^= 1;
+        assert!(server.after_received(Ok(tampered)).unwrap().is_err());
+    }
+
+    #[test]
+    fn avian_private_rpc_node_info_retains_public_identity_without_secret_configuration() {
+        let redacted = redacted_node_config("instance_name = 'complete-node-identity'\nipv4 = '10.64.0.2'\ncredential_file = '/private/credential'\n[secure_mode]\nenabled = true\nlocal_public_key = 'public-transport-key'\nlocal_private_key = 'private-transport-key'\n[network_identity]\nnetwork_secret = 'administrator-secret'\n".into());
+        let document: toml::Value = redacted.parse().unwrap();
+        assert_eq!(
+            document["instance_name"].as_str(),
+            Some("complete-node-identity")
+        );
+        assert_eq!(
+            document["secure_mode"]["local_public_key"].as_str(),
+            Some("public-transport-key")
+        );
+        for secret in [
+            "private-transport-key",
+            "administrator-secret",
+            "/private/credential",
+            "local_private_key",
+            "network_secret",
+        ] {
+            assert!(!redacted.contains(secret));
+        }
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn avian_private_rpc_token_requires_owner_only_files_and_rejects_links() {
+        use std::os::unix::fs::{PermissionsExt, symlink};
+        let directory = tempfile::tempdir().unwrap();
+        let token = directory.path().join("rpc-token");
+        std::fs::write(&token, "07".repeat(32)).unwrap();
+        std::fs::set_permissions(&token, std::fs::Permissions::from_mode(0o600)).unwrap();
+        assert!(protected_token(&token).is_ok());
+        std::fs::set_permissions(&token, std::fs::Permissions::from_mode(0o644)).unwrap();
+        assert!(protected_token(&token).is_err());
+        std::fs::set_permissions(&token, std::fs::Permissions::from_mode(0o600)).unwrap();
+        let link = directory.path().join("link");
+        symlink(&token, &link).unwrap();
+        assert!(protected_token(&link).is_err());
+        std::fs::write(&token, "0".repeat(64)).unwrap();
+        assert!(protected_token(&token).is_err());
+    }
+    #[test]
+    fn avian_private_rpc_handshake_domain_cannot_be_substituted() {
+        let secret = [7u8; 32];
+        let params: NoiseParams = PATTERN.parse().unwrap();
+        let mut client = Builder::new(params.clone())
+            .prologue(PROLOGUE)
+            .unwrap()
+            .psk(0, &secret)
+            .unwrap()
+            .build_initiator()
+            .unwrap();
+        let mut other_protocol = Builder::new(params)
+            .prologue(b"unrelated-engine-protocol")
+            .unwrap()
+            .psk(0, &secret)
+            .unwrap()
+            .build_responder()
+            .unwrap();
+        let mut message = [0u8; 1024];
+        let length = client.write_message(&[], &mut message).unwrap();
+        let mut plaintext = [0u8; 1024];
+        assert!(
+            other_protocol
+                .read_message(&message[..length], &mut plaintext)
+                .is_err()
+        );
+    }
+}
