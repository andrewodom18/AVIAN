diff --git a/easytier/src/peers/measured_routing.rs b/easytier/src/peers/measured_routing.rs
new file mode 100644
index 0000000..51ccb4c
--- /dev/null
+++ b/easytier/src/peers/measured_routing.rs
@@ -0,0 +1,360 @@
+//! Collector-local quality windows and bounded capacity evidence for direct sessions.
+use serde::Serialize;
+use std::{
+    collections::VecDeque,
+    sync::Mutex,
+    time::{Duration, Instant},
+};
+
+pub const QUALITY_LIFETIME: Duration = Duration::from_secs(3);
+pub const CAPACITY_LIFETIME: Duration = Duration::from_secs(30);
+pub const PROBE_MARKER: &[u8] = b"AVCP";
+pub const MAX_PROBE_BYTES: usize = 512 * 1024;
+
+pub fn enabled() -> bool {
+    std::env::var("ET_MEASURED_ROUTING").as_deref() == Ok("1")
+}
+pub fn is_probe(payload: &[u8]) -> bool {
+    payload.len() >= 24 && &payload[4..8] == PROBE_MARKER
+}
+
+pub fn probe_payload_digest(payload: &[u8]) -> [u8; 32] {
+    use sha2::Digest;
+    sha2::Sha256::digest(payload).into()
+}
+
+/// Only a complete, previously admitted random packet can contribute once to delivery evidence.
+pub fn verified_probe_reply(
+    payload: &[u8],
+    pending: &mut std::collections::BTreeMap<u32, [u8; 32]>,
+) -> Option<u32> {
+    if !(64..=1000).contains(&payload.len()) || !is_probe(payload) {
+        return None;
+    }
+    let sequence = u32::from_le_bytes(payload[..4].try_into().ok()?);
+    if *pending.get(&sequence)? != probe_payload_digest(payload) {
+        return None;
+    }
+    pending.remove(&sequence);
+    Some(sequence)
+}
+
+pub fn packet_is_probe(packet: &crate::tunnel::packet_def::ZCPacket) -> bool {
+    use crate::tunnel::packet_def::PacketType;
+    packet.peer_manager_header().is_some_and(|header| {
+        (header.packet_type == PacketType::Ping as u8
+            || header.packet_type == PacketType::Pong as u8)
+            && is_probe(packet.payload())
+    })
+}
+
+/// Ten-percent buckets keep measured threshold searches bounded independently of membership.
+/// Rounding down preserves the delivered-rate lower-bound meaning, including low-rate radios.
+fn quantized_capacity(rate: u64) -> u64 {
+    if rate == 0 {
+        return 0;
+    }
+    let mut bucket = 1u64;
+    while let Some(next) = bucket.checked_add(bucket.div_ceil(10)) {
+        if next > rate {
+            break;
+        }
+        bucket = next;
+    }
+    bucket
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct ProbeEvidence {
+    pub peer_id: u32,
+    pub connection_id: String,
+    pub method: &'static str,
+    pub delivered_rate_lower_bound_bps: u64,
+    pub offered_payload_bytes: u64,
+    pub accepted_payload_bytes: u64,
+    pub delivered_payload_bytes: u64,
+    pub measurement_duration_ms: u64,
+    pub received_datagrams: u64,
+    #[serde(skip)]
+    pub collected_at: Instant,
+}
+
+#[derive(Default)]
+struct State {
+    samples: VecDeque<(Instant, Option<u64>)>,
+    sequence: u64,
+    probe: Option<ProbeEvidence>,
+    next_probe: Option<Instant>,
+    echo_window: Option<Instant>,
+    echo_bytes: usize,
+    echo_packets: usize,
+}
+
+#[derive(Default)]
+pub struct Measurements {
+    state: Mutex<State>,
+}
+
+impl Measurements {
+    pub fn record_quality(&self, latency_us: Option<u64>) {
+        let mut state = self.state.lock().unwrap();
+        state.sequence = state.sequence.wrapping_add(1);
+        state.samples.push_back((Instant::now(), latency_us));
+        while state.samples.len() > 15 {
+            state.samples.pop_front();
+        }
+    }
+
+    pub fn edge(
+        &self,
+        destination: u32,
+        allowed_classes: u32,
+        connection_id: String,
+        metered: bool,
+    ) -> crate::proto::peer_rpc::AvianPolicyEdge {
+        let state = self.state.lock().unwrap();
+        let now = Instant::now();
+        let samples: Vec<_> = state
+            .samples
+            .iter()
+            .filter(|(at, _)| now.duration_since(*at) <= QUALITY_LIFETIME)
+            .collect();
+        let latencies: Vec<_> = samples.iter().filter_map(|(_, latency)| *latency).collect();
+        let latency = if latencies.is_empty() {
+            0
+        } else {
+            latencies.iter().sum::<u64>() / latencies.len() as u64
+        };
+        let jitter = if latencies.len() < 2 {
+            0
+        } else {
+            latencies
+                .windows(2)
+                .map(|pair| pair[0].abs_diff(pair[1]))
+                .sum::<u64>()
+                / (latencies.len() - 1) as u64
+        };
+        let loss_ppm = if samples.is_empty() {
+            0
+        } else {
+            ((samples.len() - latencies.len()) * 1_000_000 / samples.len()) as u32
+        };
+        let probe = state
+            .probe
+            .as_ref()
+            .filter(|probe| now.duration_since(probe.collected_at) <= CAPACITY_LIFETIME);
+        crate::proto::peer_rpc::AvianPolicyEdge {
+            destination,
+            allowed_classes,
+            latency_us: latency / 1000 * 1000,
+            connection_id,
+            metered,
+            has_quality: !samples.is_empty(),
+            quality_age_ms: state
+                .samples
+                .back()
+                .map(|(at, _)| now.duration_since(*at).as_millis() as u64)
+                .unwrap_or(u64::MAX),
+            jitter_us: jitter / 1000 * 1000,
+            loss_ppm,
+            measurement_sequence: state.sequence,
+            capacity_bps: probe
+                .map(|value| quantized_capacity(value.delivered_rate_lower_bound_bps))
+                .unwrap_or(0),
+            capacity_age_ms: probe
+                .map(|value| now.duration_since(value.collected_at).as_millis() as u64)
+                .unwrap_or(u64::MAX),
+            ..Default::default()
+        }
+    }
+
+    pub fn reserve_probe(&self, duration_ms: u32, offered_bps: u64) -> anyhow::Result<()> {
+        anyhow::ensure!(enabled(), "measured routing is disabled");
+        anyhow::ensure!(
+            std::env::var("ET_PRIORITY_FORWARDING").as_deref() == Ok("1"),
+            "capacity probes require priority forwarding"
+        );
+        anyhow::ensure!(
+            (50..=500).contains(&duration_ms),
+            "probe duration must be 50..500 ms"
+        );
+        anyhow::ensure!(
+            (64_000..=8_000_000).contains(&offered_bps),
+            "probe rate must be 64000..8000000 bps"
+        );
+        anyhow::ensure!(
+            u64::from(duration_ms) * offered_bps / 8000 <= MAX_PROBE_BYTES as u64,
+            "probe byte budget exceeded"
+        );
+        let mut state = self.state.lock().unwrap();
+        let now = Instant::now();
+        anyhow::ensure!(
+            state.next_probe.is_none_or(|deadline| now >= deadline),
+            "probe cooldown is active"
+        );
+        let samples: Vec<_> = state
+            .samples
+            .iter()
+            .filter(|(at, _)| now.duration_since(*at) <= QUALITY_LIFETIME)
+            .collect();
+        anyhow::ensure!(
+            samples.len() >= 2,
+            "fresh link quality is required before probing"
+        );
+        let losses = samples
+            .iter()
+            .filter(|(_, latency)| latency.is_none())
+            .count();
+        anyhow::ensure!(
+            losses * 20 <= samples.len(),
+            "link loss indicates congestion; probe refused"
+        );
+        let latencies: Vec<_> = samples.iter().filter_map(|(_, latency)| *latency).collect();
+        if latencies.len() >= 2 {
+            let jitter = latencies
+                .windows(2)
+                .map(|pair| pair[0].abs_diff(pair[1]))
+                .sum::<u64>()
+                / (latencies.len() - 1) as u64;
+            anyhow::ensure!(
+                jitter <= 100_000,
+                "link jitter indicates congestion; probe refused"
+            );
+        }
+        state.next_probe = Some(now + CAPACITY_LIFETIME);
+        Ok(())
+    }
+
+    pub fn record_probe(&self, evidence: ProbeEvidence) {
+        let mut state = self.state.lock().unwrap();
+        state.sequence = state.sequence.wrapping_add(1);
+        state.probe = Some(evidence);
+    }
+
+    pub fn permit_echo(&self, bytes: usize) -> bool {
+        if !enabled()
+            || std::env::var("ET_PRIORITY_FORWARDING").as_deref() != Ok("1")
+            || !(64..=1000).contains(&bytes)
+        {
+            return false;
+        }
+        let mut state = self.state.lock().unwrap();
+        let now = Instant::now();
+        if state
+            .echo_window
+            .is_none_or(|at| now.duration_since(at) >= CAPACITY_LIFETIME)
+        {
+            state.echo_window = Some(now);
+            state.echo_bytes = 0;
+            state.echo_packets = 0;
+        }
+        if state.echo_bytes + bytes > MAX_PROBE_BYTES || state.echo_packets >= 512 {
+            return false;
+        }
+        state.echo_bytes += bytes;
+        state.echo_packets += 1;
+        true
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::tunnel::packet_def::{PacketType, ZCPacket};
+
+    #[test]
+    fn avian_measured_quality_reports_loss_without_inventing_capacity() {
+        let measurements = Measurements::default();
+        measurements.record_quality(Some(2_000));
+        measurements.record_quality(None);
+        let edge = measurements.edge(2, 30, "connection".into(), false);
+        assert!(edge.has_quality);
+        assert_eq!(edge.loss_ppm, 500_000);
+        assert_eq!(edge.latency_us, 2_000);
+        assert_eq!(edge.capacity_bps, 0);
+    }
+
+    #[test]
+    fn avian_measured_header_reinitialization_clears_previous_class() {
+        let mut packet = ZCPacket::new_with_payload(b"application");
+        packet.fill_peer_manager_hdr(1, 2, PacketType::Data as u8);
+        packet
+            .mut_peer_manager_header()
+            .unwrap()
+            .set_avian_traffic_class(255);
+        packet.fill_peer_manager_hdr(1, 2, PacketType::Data as u8);
+        assert_eq!(
+            packet.peer_manager_header().unwrap().avian_traffic_class(),
+            0
+        );
+        assert!(!packet_is_probe(&packet));
+    }
+}
+
+pub fn probe_packet_dimensions(duration_ms: u32, offered_bps: u64) -> (usize, u64) {
+    let byte_budget = u64::from(duration_ms) * offered_bps / 8_000;
+    let payload_bytes = (byte_budget / 8).clamp(64, 1000) as usize;
+    (payload_bytes, byte_budget / payload_bytes as u64)
+}
+
+pub const PAGE_BYTE_BUDGET: usize = 256 * 1024;
+pub fn page_limit(requested: u32) -> anyhow::Result<usize> {
+    let limit = if requested == 0 { 100 } else { requested };
+    anyhow::ensure!(limit <= 1000, "page limit must be 1..1000");
+    Ok(limit as usize)
+}
+
+#[cfg(test)]
+mod bounded_measurement_tests {
+    use super::*;
+    #[test]
+    fn avian_measured_capacity_buckets_remain_conservative_at_low_and_high_rates() {
+        assert_eq!(quantized_capacity(0), 0);
+        for rate in [1, 9, 10, 64_000, 8_000_000, u64::MAX] {
+            let quantized = quantized_capacity(rate);
+            assert!(quantized > 0 && quantized <= rate);
+        }
+        assert_eq!(page_limit(0).unwrap(), 100);
+        assert_eq!(page_limit(1000).unwrap(), 1000);
+        assert!(page_limit(1001).is_err());
+    }
+}
+
+#[cfg(test)]
+mod probe_challenge_tests {
+    use super::*;
+    #[test]
+    fn avian_measured_probe_requires_complete_admitted_packets_and_consumes_them_once() {
+        let mut packet = vec![17u8; 1000];
+        packet[..4].copy_from_slice(&2u32.to_le_bytes());
+        packet[4..8].copy_from_slice(PROBE_MARKER);
+        packet[984..1000].copy_from_slice(&200u128.to_le_bytes());
+        let mut pending = std::collections::BTreeMap::from([(2, probe_payload_digest(&packet))]);
+        let mut prefix_only = packet.clone();
+        prefix_only[500] ^= 1;
+        assert_eq!(verified_probe_reply(&prefix_only, &mut pending), None);
+        let mut unadmitted = packet.clone();
+        unadmitted[..4].copy_from_slice(&3u32.to_le_bytes());
+        assert_eq!(verified_probe_reply(&unadmitted, &mut pending), None);
+        assert_eq!(verified_probe_reply(&packet, &mut pending), Some(2));
+        assert_eq!(verified_probe_reply(&packet, &mut pending), None);
+    }
+}
+
+#[cfg(test)]
+mod probe_budget_tests {
+    use super::*;
+    #[test]
+    fn avian_measured_probe_packet_budget_does_not_overshoot_small_or_large_requests() {
+        assert_eq!(probe_packet_dimensions(50, 64_000), (64, 6));
+        assert_eq!(probe_packet_dimensions(500, 8_000_000), (1000, 500));
+        for duration in [50, 125, 500] {
+            for rate in [64_000, 128_000, 8_000_000] {
+                let (bytes, packets) = probe_packet_dimensions(duration, rate);
+                assert!((64..=1000).contains(&bytes));
+                assert!(bytes as u64 * packets <= u64::from(duration) * rate / 8_000);
+                assert!(bytes as u64 * packets <= MAX_PROBE_BYTES as u64);
+            }
+        }
+    }
+}
