@@ -0,0 +1,272 @@
+//! Use the shared planner for the routes that packet dispatch actually selects.
+use crate::{common::PeerId, proto::peer_rpc::RoutePeerInfo};
+use avian_routing::{
+    CapacitySource, FlowPolicy, FlowRequest, FlowRouter, LinkObservation, NetworkNode,
+    NetworkSnapshot, Route, RouteChangeReason, RoutePlanner, RoutingPolicy, TrafficClass,
+};
+use serde::Serialize;
+use std::{
+    collections::BTreeMap,
+    time::{Duration, Instant},
+};
+
+#[derive(Clone, Serialize)]
+pub struct ClassDecision {
+    pub destination_peer_id: PeerId,
+    pub traffic_class: TrafficClass,
+    pub next_hop_peer_id: PeerId,
+    pub connection_id: String,
+    pub route: Route,
+    pub reason: RouteChangeReason,
+    pub improvement_hold_ms: Option<u64>,
+    pub destination_transport_key: Vec<u8>,
+}
+
+pub struct MeasuredTopology {
+    origin: Instant,
+    router: FlowRouter,
+    pub decisions: BTreeMap<(PeerId, u8), ClassDecision>,
+    pub revision: u64,
+}
+impl Default for MeasuredTopology {
+    fn default() -> Self {
+        Self {
+            origin: Instant::now(),
+            router: FlowRouter::new(
+                RoutePlanner::new(RoutingPolicy {
+                    allow_metered_video: true,
+                    allow_metered_bulk: true,
+                    ..Default::default()
+                }),
+                FlowPolicy {
+                    maximum_active_flows: usize::MAX,
+                    idle_timeout_ms: u64::MAX,
+                    improvement_hold_ms: 5_000,
+                },
+            )
+            .unwrap(),
+            decisions: BTreeMap::new(),
+            revision: 0,
+        }
+    }
+}
+impl MeasuredTopology {
+    pub fn calculate(&mut self, source: PeerId, records: &[(RoutePeerInfo, Duration)]) -> Duration {
+        let now_ms = self.origin.elapsed().as_millis() as u64;
+        let source_id = source.to_string();
+        let nodes: Vec<_> = records
+            .iter()
+            .map(|(record, _)| NetworkNode {
+                node_id: record.peer_id.to_string(),
+                relay_allowed: !record
+                    .feature_flag
+                    .is_some_and(|flags| flags.avoid_relay_data),
+            })
+            .collect();
+        let node_ids: std::collections::BTreeSet<_> =
+            nodes.iter().map(|node| node.node_id.as_str()).collect();
+        let transport_keys: BTreeMap<_, _> = records
+            .iter()
+            .map(|(record, _)| (record.peer_id, record.noise_static_pubkey.clone()))
+            .collect();
+        let mut next_expiry_ms = 1_000;
+        let mut decisions = BTreeMap::new();
+        for (class_id, traffic_class) in [
+            (1, TrafficClass::Control),
+            (2, TrafficClass::Telemetry),
+            (3, TrafficClass::Video),
+            (4, TrafficClass::Bulk),
+        ] {
+            let mut links = Vec::new();
+            for (record, received_age) in records {
+                let received_age_ms = received_age.as_millis() as u64;
+                for (index, edge) in record.avian_policy_edges.iter().enumerate() {
+                    let quality_age = edge.quality_age_ms.saturating_add(received_age_ms);
+                    let capacity_age = edge.capacity_age_ms.saturating_add(received_age_ms);
+                    let quality_fresh = edge.has_quality && quality_age <= 3_000;
+                    let capacity_fresh = edge.capacity_bps > 0 && capacity_age <= 30_000;
+                    if quality_fresh {
+                        next_expiry_ms = next_expiry_ms.min(3_001 - quality_age);
+                    }
+                    if capacity_fresh {
+                        next_expiry_ms = next_expiry_ms.min(30_001 - capacity_age);
+                    }
+                    let connection_id = if edge.connection_id.is_empty() {
+                        format!("legacy-{index}")
+                    } else {
+                        edge.connection_id.clone()
+                    };
+                    links.push(LinkObservation {
+                        link_id: format!("{}:{connection_id}", record.peer_id),
+                        source: record.peer_id.to_string(),
+                        destination: edge.destination.to_string(),
+                        interface_name: connection_id,
+                        available: edge.allowed_classes & (1 << class_id) != 0,
+                        metered: edge.metered,
+                        observed_at_ms: if quality_fresh {
+                            now_ms.saturating_sub(quality_age)
+                        } else {
+                            now_ms
+                        },
+                        round_trip_time_ms: quality_fresh
+                            .then_some(edge.latency_us as f64 / 1000.0),
+                        loss_fraction: quality_fresh
+                            .then_some((edge.loss_ppm.min(1_000_000) as f64) / 1_000_000.0),
+                        jitter_ms: quality_fresh.then_some(edge.jitter_us as f64 / 1000.0),
+                        available_capacity_bps: capacity_fresh.then_some(edge.capacity_bps),
+                        topology_valid_until_ms: Some(
+                            now_ms.saturating_add(20_000u64.saturating_sub(received_age_ms)),
+                        ),
+                        capacity_valid_until_ms: capacity_fresh
+                            .then(|| now_ms.saturating_add(30_000 - capacity_age)),
+                        capacity_source: capacity_fresh.then_some(CapacitySource::BoundedProbe),
+                    });
+                }
+            }
+            // An advertisement can reference a neighbor whose authenticated record has expired.
+            links.retain(|link| node_ids.contains(link.destination.as_str()));
+            let snapshot = NetworkSnapshot {
+                nodes: nodes.clone(),
+                links,
+            };
+            let destinations: Vec<_> = records
+                .iter()
+                .filter(|(record, _)| record.peer_id != source)
+                .map(|(record, _)| record.peer_id)
+                .collect();
+            let requests = destinations
+                .iter()
+                .map(|destination| FlowRequest {
+                    flow_id: format!("{class_id}:{destination}"),
+                    source: source_id.clone(),
+                    destination: destination.to_string(),
+                    traffic_class,
+                })
+                .collect();
+            let batch = self
+                .router
+                .route_batch(&snapshot, requests, now_ms)
+                .unwrap_or_default();
+            for (destination, decision) in destinations.into_iter().zip(batch) {
+                if let Ok(decision) = decision {
+                    let next_hop = decision
+                        .route
+                        .node_ids
+                        .get(1)
+                        .and_then(|id| id.parse().ok());
+                    let connection = decision
+                        .route
+                        .link_ids
+                        .first()
+                        .and_then(|id| id.split_once(':'))
+                        .map(|(_, id)| id.to_owned());
+                    if let (Some(next_hop_peer_id), Some(connection_id)) = (next_hop, connection) {
+                        decisions.insert(
+                            (destination, class_id),
+                            ClassDecision {
+                                destination_peer_id: destination,
+                                traffic_class,
+                                next_hop_peer_id,
+                                connection_id,
+                                route: decision.route,
+                                reason: decision.reason,
+                                improvement_hold_ms: decision.improvement_hold_ms,
+                                destination_transport_key: transport_keys
+                                    .get(&destination)
+                                    .cloned()
+                                    .unwrap_or_default(),
+                            },
+                        );
+                    }
+                }
+            }
+        }
+        self.router.retain_flows(
+            &decisions
+                .keys()
+                .map(|(destination, class)| format!("{class}:{destination}"))
+                .collect(),
+        );
+        let changed = self.decisions.len() != decisions.len()
+            || decisions.iter().any(|(key, next)| {
+                self.decisions.get(key).is_none_or(|previous| {
+                    previous.next_hop_peer_id != next.next_hop_peer_id
+                        || previous.connection_id != next.connection_id
+                        || previous.route.link_ids != next.route.link_ids
+                        || previous.route.degraded != next.route.degraded
+                        || previous.route.degraded_reasons != next.route.degraded_reasons
+                        || previous.route.uses_metered_link != next.route.uses_metered_link
+                })
+            });
+        if changed {
+            self.revision = self.revision.saturating_add(1);
+        }
+        self.decisions = decisions;
+        Duration::from_millis(next_expiry_ms.max(1))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn avian_measured_initial_unknown_metrics_are_usable_without_deadline_overflow() {
+        let mut source = RoutePeerInfo::new();
+        source.peer_id = 1;
+        source
+            .avian_policy_edges
+            .push(crate::proto::peer_rpc::AvianPolicyEdge {
+                destination: 2,
+                allowed_classes: 30,
+                connection_id: "connection".into(),
+                quality_age_ms: u64::MAX,
+                capacity_age_ms: u64::MAX,
+                ..Default::default()
+            });
+        let mut destination = RoutePeerInfo::new();
+        destination.peer_id = 2;
+        let mut topology = MeasuredTopology::default();
+        topology.calculate(
+            1,
+            &[(source, Duration::ZERO), (destination, Duration::ZERO)],
+        );
+        assert!(topology.decisions[&(2, 3)].route.degraded);
+        assert_eq!(
+            topology.decisions[&(2, 3)].route.bottleneck_capacity_bps,
+            None
+        );
+    }
+}
+
+#[cfg(test)]
+mod graph_growth_tests {
+    use super::*;
+    #[test]
+    fn avian_measured_destination_state_has_no_default_flow_count_membership_ceiling() {
+        let destinations = FlowPolicy::default().maximum_active_flows / 4 + 2;
+        let mut source = RoutePeerInfo::new();
+        source.peer_id = 1;
+        let mut records = Vec::new();
+        for index in 0..destinations {
+            let destination = index as u32 + 2;
+            source
+                .avian_policy_edges
+                .push(crate::proto::peer_rpc::AvianPolicyEdge {
+                    destination,
+                    allowed_classes: 30,
+                    connection_id: format!("connection-{index}"),
+                    quality_age_ms: u64::MAX,
+                    capacity_age_ms: u64::MAX,
+                    ..Default::default()
+                });
+            let mut record = RoutePeerInfo::new();
+            record.peer_id = destination;
+            records.push((record, Duration::ZERO));
+        }
+        records.push((source, Duration::ZERO));
+        let mut topology = MeasuredTopology::default();
+        topology.calculate(1, &records);
+        assert_eq!(topology.decisions.len(), destinations * 4);
+        assert!(topology.decisions.len() > FlowPolicy::default().maximum_active_flows);
+    }
+}
