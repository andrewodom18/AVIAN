+pub(crate) fn policy() -> Result<Arc<LocalPolicy>, String> {
+    type CachedPolicy = Option<(String, Instant, Result<Arc<LocalPolicy>, String>)>;
+    static CACHE: OnceLock<Mutex<CachedPolicy>> = OnceLock::new();
+    let path = match std::env::var("AVIAN_TRAFFIC_POLICY_FILE") {
+        Ok(path) => path,
+        Err(std::env::VarError::NotPresent) => return configured_policy().clone(),
+        Err(_) => return Err("invalid policy file path".into()),
+    };
+    let mut cache = CACHE.get_or_init(|| Mutex::new(None)).lock().unwrap();
+    if let Some((cached_path, at, result)) = &*cache {
+        if *cached_path == path && at.elapsed() < Duration::from_millis(100) {
+            return result.clone();
+        }
+    }
+    let result = read_policy_file(&path);
+    *cache = Some((path, Instant::now(), result.clone()));
+    result
+}
