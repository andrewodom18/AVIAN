+impl PeerConn {
+    pub(crate) fn has_queued_packets(&self) -> bool {
+        self.sink.has_queued_packets()
+    }
+
+    pub(crate) async fn probe_capacity(
+        &self,
+        duration_ms: u32,
+        offered_bps: u64,
+        allow_metered: bool,
+    ) -> anyhow::Result<super::measured_routing::ProbeEvidence> {
+        use rand::RngCore;
+        use std::time::{Duration, Instant};
+        static PROBES: std::sync::OnceLock<tokio::sync::Semaphore> = std::sync::OnceLock::new();
+        let _probe_slot = PROBES
+            .get_or_init(|| tokio::sync::Semaphore::new(1))
+            .try_acquire()
+            .map_err(|_| anyhow::anyhow!("another capacity probe is active"))?;
+        anyhow::ensure!(!self.is_closed(), "connection is closed");
+        anyhow::ensure!(
+            super::traffic_policy::probe_permitted(
+                self.get_conn_info().tunnel.as_ref(),
+                allow_metered
+            ),
+            "capacity probe is prohibited on this metered connection"
+        );
+        anyhow::ensure!(
+            !self.sink.has_queued_packets(),
+            "connection has queued traffic; probe refused"
+        );
+        self.measurements.reserve_probe(duration_ms, offered_bps)?;
+        let mut responses = self.ctrl_resp_sender.subscribe();
+        let started = Instant::now();
+        let sending_deadline = started + Duration::from_millis(u64::from(duration_ms));
+        let deadline = sending_deadline + Duration::from_secs(2);
+        let (payload_bytes, packet_budget) =
+            super::measured_routing::probe_packet_dimensions(duration_ms, offered_bps);
+        let mut interval = tokio::time::interval(Duration::from_nanos(
+            payload_bytes as u64 * 8_000_000_000 / offered_bps,
+        ));
+        interval.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+        let mut attempted = 0u64;
+        let mut accepted = std::collections::BTreeMap::new();
+        let mut admitted_count = 0u64;
+        let mut delivered_count = 0u64;
+        let mut last_received = None;
+        loop {
+            if Instant::now() >= deadline {
+                break;
+            }
+            if (Instant::now() >= sending_deadline || attempted >= packet_budget)
+                && delivered_count >= admitted_count
+            {
+                break;
+            }
+            tokio::select! {
+                _ = interval.tick(), if Instant::now() < sending_deadline && attempted < packet_budget => {
+                    let sequence = 0x8000_0000 | attempted as u32;
+                    let mut payload = vec![0u8; payload_bytes];
+                    rand::thread_rng().fill_bytes(&mut payload);
+                    payload[..4].copy_from_slice(&sequence.to_le_bytes());
+                    payload[4..8].copy_from_slice(super::measured_routing::PROBE_MARKER);
+                    let challenge: u128 = rand::random();
+                    payload[payload_bytes - 16..].copy_from_slice(&challenge.to_le_bytes());
+                    let commitment = super::measured_routing::probe_payload_digest(&payload);
+                    let mut packet = ZCPacket::new_with_payload(&payload);
+                    packet.fill_peer_manager_hdr(self.my_peer_id, self.get_peer_id(), PacketType::Ping as u8);
+                    attempted += 1;
+                    if self.sink.try_send(packet).is_ok() {
+                        accepted.insert(sequence, commitment); admitted_count += 1;
+                    }
+                }
+                response = responses.recv() => {
+                    if let Ok(packet) = response {
+                        let payload = packet.payload();
+                        if super::measured_routing::verified_probe_reply(payload, &mut accepted).is_some() {
+                            delivered_count += 1; last_received = Some(Instant::now());
+                        }
+                    }
+                }
+                _ = tokio::time::sleep_until(deadline.into()) => break,
+            }
+        }
+        anyhow::ensure!(
+            delivered_count > 0,
+            "capacity probe received no authenticated replies"
+        );
+        let elapsed = last_received
+            .unwrap()
+            .duration_since(started)
+            .max(Duration::from_millis(u64::from(duration_ms)));
+        let delivered_bytes = delivered_count * payload_bytes as u64;
+        let evidence = super::measured_routing::ProbeEvidence {
+            peer_id: self.get_peer_id(),
+            connection_id: self.conn_id.to_string(),
+            method: "bounded_probe_delivered_rate_lower_bound",
+            delivered_rate_lower_bound_bps: (delivered_bytes as f64 * 8.0 / elapsed.as_secs_f64())
+                as u64,
+            offered_payload_bytes: attempted * payload_bytes as u64,
+            accepted_payload_bytes: admitted_count * payload_bytes as u64,
+            delivered_payload_bytes: delivered_bytes,
+            measurement_duration_ms: elapsed.as_millis() as u64,
+            received_datagrams: delivered_count,
+            collected_at: last_received.unwrap(),
+        };
+        self.measurements.record_probe(evidence.clone());
+        Ok(evidence)
+    }
+}
