+/// Capacity probes need an explicit local policy decision independent of their wire type.
+pub(crate) fn probe_permitted(tunnel: Option<&TunnelInfo>, allow_metered: bool) -> bool {
+    let Ok(policy) = policy() else {
+        return false;
+    };
+    let address = tunnel
+        .and_then(|info| info.local_addr.as_ref())
+        .and_then(|address| url::Url::parse(&address.url).ok())
+        .and_then(|address| address.host_str().map(str::to_owned))
+        .and_then(|address| address.trim_matches(['[', ']']).parse::<IpAddr>().ok())
+        .filter(|address| !address.is_unspecified());
+    if address.is_none() && std::env::var_os("AVIAN_TRAFFIC_POLICY_FILE").is_some() {
+        return false;
+    }
+    let metered = address.is_some_and(|address| policy.metered_addresses.contains(&address));
+    !metered || allow_metered && policy.allow_metered_bulk
+}
