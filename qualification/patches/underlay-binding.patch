+#[derive(Clone, Debug)]
+struct UnderlayBinding {
+    source: IpAddr,
+    interface_name: String,
+}
+
+fn parse_underlay_binding(url: &url::Url) -> Result<Option<UnderlayBinding>, Error> {
+    let Some(query) = url.query() else {
+        return Ok(None);
+    };
+    if !matches!(url.scheme(), "tcp" | "udp") || query.len() > 512 || query.split('&').count() != 2
+    {
+        return Err(Error::InvalidUrl("invalid underlay binding options".into()));
+    }
+    let pairs = url.query_pairs().collect::<Vec<_>>();
+    let source = pairs
+        .iter()
+        .filter(|(name, _)| name == "avian_bind")
+        .collect::<Vec<_>>();
+    let interface = pairs
+        .iter()
+        .filter(|(name, _)| name == "avian_interface")
+        .collect::<Vec<_>>();
+    if pairs.len() != 2 || source.len() != 1 || interface.len() != 1 {
+        return Err(Error::InvalidUrl("invalid underlay binding options".into()));
+    }
+    let source = source[0]
+        .1
+        .parse::<IpAddr>()
+        .map_err(|_| Error::InvalidUrl("invalid underlay source".into()))?;
+    let interface_name = interface[0].1.to_string();
+    if source.is_unspecified()
+        || source.is_loopback()
+        || source.is_multicast()
+        || matches!(source, IpAddr::V6(address) if address.is_unicast_link_local())
+        || interface_name.is_empty()
+        || interface_name.len() > 15
+        || !interface_name
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-' | b'.'))
+    {
+        return Err(Error::InvalidUrl(
+            "invalid underlay source or interface".into(),
+        ));
+    }
+    Ok(Some(UnderlayBinding {
+        source,
+        interface_name,
+    }))
+}
+
+async fn validate_underlay_binding(
+    binding: &UnderlayBinding,
+    global_ctx: &ArcGlobalCtx,
+) -> Result<(), Error> {
+    if !cfg!(target_os = "linux") {
+        return Err(Error::InvalidUrl(
+            "native interface binding is unavailable on this platform".into(),
+        ));
+    }
+    if global_ctx.is_ip_local_virtual_ip(&binding.source)
+        || matches!(binding.source, IpAddr::V6(address) if global_ctx.is_ip_easytier_managed_ipv6(&address))
+    {
+        return Err(Error::InvalidUrl(
+            "overlay addresses cannot bind an underlay".into(),
+        ));
+    }
+    // Enumerate current interfaces rather than using the engine's 60-second address cache.
+    let interfaces =
+        crate::common::network::IPCollector::collect_interfaces(global_ctx.net_ns.clone(), false)
+            .await;
+    if !interfaces.iter().any(|interface| {
+        interface.name == binding.interface_name
+            && interface
+                .ips
+                .iter()
+                .any(|address| address.ip() == binding.source)
+    }) {
+        return Err(Error::InvalidUrl(
+            "underlay source is not assigned to the requested interface".into(),
+        ));
+    }
+    Ok(())
+}
+
+pub(crate) fn bind_socket_to_underlay(
+    socket: socket2::SockRef<'_>,
+    interface: &str,
+) -> std::io::Result<()> {
+    #[cfg(target_os = "linux")]
+    {
+        socket.bind_device(Some(interface.as_bytes()))
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        let _ = (socket, interface);
+        Err(std::io::Error::other(
+            "native interface binding is unavailable",
+        ))
+    }
+}
