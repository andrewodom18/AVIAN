+#[cfg(test)]
+mod avian_underlay_tests {
+    use super::*;
+    #[test]
+    fn avian_underlay_binding_rejects_ambiguous_or_unsupported_options() {
+        for query in [
+            "avian_bind=192.0.2.2",
+            "avian_bind=192.0.2.2&avian_bind=192.0.2.3",
+            "avian_bind=192.0.2.2&avian_interface=eth0&other=1",
+            "avian_bind=0.0.0.0&avian_interface=eth0",
+            "avian_bind=127.0.0.1&avian_interface=lo",
+            "avian_bind=%FF&avian_interface=eth0",
+            "avian_bind=192.0.2.2&avian_interface=bad/interface",
+            "avian_bind=192.0.2.2&other=eth0",
+        ] {
+            assert!(
+                parse_underlay_binding(
+                    &url::Url::parse(&format!("tcp://192.0.2.4:11010?{query}")).unwrap()
+                )
+                .is_err()
+            );
+        }
+        let binding = parse_underlay_binding(
+            &url::Url::parse(
+                "udp://[2001:db8::4]:11010?avian_bind=2001%3Adb8%3A%3A2&avian_interface=eth0",
+            )
+            .unwrap(),
+        )
+        .unwrap()
+        .unwrap();
+        assert_eq!(binding.source, "2001:db8::2".parse::<IpAddr>().unwrap());
+        assert_eq!(binding.interface_name, "eth0");
+    }
+    #[tokio::test]
+    async fn avian_underlay_binding_rejects_nonlocal_sources_before_connecting() {
+        let context = crate::common::global_ctx::tests::get_mock_global_ctx();
+        let result = create_connector_by_url(
+            "tcp://192.0.2.4:11010?avian_bind=192.0.2.2&avian_interface=doesnotexist",
+            &context,
+            IpVersion::Both,
+        )
+        .await;
+        assert!(matches!(result, Err(Error::InvalidUrl(_))));
+    }
+    #[cfg(target_os = "linux")]
+    #[tokio::test]
+    async fn avian_underlay_socket_device_is_pinned_and_unknown_devices_fail_closed() {
+        let socket = tokio::net::UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let reference = socket2::SockRef::from(&socket);
+        bind_socket_to_underlay(reference, "lo").unwrap();
+        assert_eq!(
+            socket2::SockRef::from(&socket).device().unwrap(),
+            Some(b"lo".to_vec())
+        );
+        assert!(
+            bind_socket_to_underlay(socket2::SockRef::from(&socket), "no-such-device").is_err()
+        );
+    }
+}
