+#[cfg(test)]
+mod avian_underlay_tcp_tests {
+    use super::*;
+    use crate::tunnel::TunnelConnector;
+
+    #[tokio::test]
+    async fn avian_underlay_tcp_missing_source_never_uses_default_route() {
+        let mut connector = TcpTunnelConnector::new("tcp://127.0.0.1:9".parse().unwrap());
+        connector.set_underlay_interface("doesnotexist".into());
+        assert!(matches!(
+            connector.connect().await,
+            Err(TunnelError::InvalidAddr(_))
+        ));
+    }
+    #[cfg(target_os = "linux")]
+    #[tokio::test]
+    async fn avian_underlay_tcp_device_pinning_preserves_return_path() {
+        use crate::tunnel::{TunnelListener, packet_def::ZCPacket};
+        use futures::{SinkExt, StreamExt};
+        let mut listener = TcpTunnelListener::new("tcp://127.0.0.1:0".parse().unwrap());
+        listener.listen().await.unwrap();
+        let mut connector = TcpTunnelConnector::new(listener.local_url());
+        connector.set_bind_addrs(vec!["127.0.0.1:0".parse().unwrap()]);
+        connector.set_underlay_interface("lo".into());
+        let (connected, accepted) =
+            tokio::time::timeout(std::time::Duration::from_secs(2), async {
+                tokio::join!(connector.connect(), listener.accept())
+            })
+            .await
+            .unwrap();
+        let connected = connected.unwrap();
+        let accepted = accepted.unwrap();
+        let (mut client_receive, mut client_send) = connected.split();
+        let (mut server_receive, mut server_send) = accepted.split();
+        client_send
+            .send(ZCPacket::new_with_payload(b"pinned TCP return path"))
+            .await
+            .unwrap();
+        let packet = tokio::time::timeout(std::time::Duration::from_secs(1), server_receive.next())
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap();
+        server_send.send(packet).await.unwrap();
+        let echoed = tokio::time::timeout(std::time::Duration::from_secs(1), client_receive.next())
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap();
+        assert_eq!(echoed.payload(), b"pinned TCP return path");
+    }
+}
