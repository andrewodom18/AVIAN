+#[cfg(test)]
+mod priority_tests {
+    use super::*;
+    use crate::tunnel::packet_def::PacketType;
+
+    fn queues() -> (MpscTunnelSender, PriorityReceiver) {
+        let (control_tx, control_rx) = channel(16);
+        let (telemetry_tx, telemetry_rx) = channel(16);
+        let (video_tx, video_rx) = channel(32);
+        let (bulk_tx, bulk_rx) = channel(32);
+        let (ordinary, _) = channel(1);
+        let wake = Arc::new(tokio::sync::Notify::new());
+        (
+            MpscTunnelSender {
+                ordinary,
+                priority: Some(Arc::new(PrioritySender {
+                    channels: [control_tx, telemetry_tx, video_tx, bulk_tx],
+                    wake: wake.clone(),
+                })),
+            },
+            PriorityReceiver {
+                channels: [control_rx, telemetry_rx, video_rx, bulk_rx],
+                wake,
+                position: 0,
+            },
+        )
+    }
+
+    fn packet(class: u8, sequence: u8) -> ZCPacket {
+        let mut packet = ZCPacket::new_with_payload(&[sequence]);
+        packet.fill_peer_manager_hdr(1, 2, PacketType::Data as u8);
+        packet
+            .mut_peer_manager_header()
+            .unwrap()
+            .set_avian_traffic_class(class);
+        packet
+    }
+
+    #[tokio::test]
+    async fn avian_congestion_bulk_capacity_does_not_consume_control_reserve() {
+        let (sender, mut receiver) = queues();
+        for sequence in 0..32 {
+            sender.send(packet(4, sequence)).await.unwrap();
+        }
+        assert!(matches!(
+            sender.send(packet(4, 32)).await,
+            Err(TunnelError::BufferFull)
+        ));
+        sender.send(packet(1, 42)).await.unwrap();
+        assert_eq!(receiver.next().await.unwrap().payload(), &[42]);
+        assert_eq!(receiver.next().await.unwrap().payload(), &[0]);
+    }
+
+    #[tokio::test]
+    async fn avian_congestion_weighted_service_preserves_class_fifo_and_bulk_progress() {
+        let (sender, mut receiver) = queues();
+        for (class, count) in [(1, 16), (2, 8), (3, 4), (4, 2)] {
+            for sequence in 0..count {
+                sender.send(packet(class, sequence)).await.unwrap();
+            }
+        }
+        let mut observed = vec![Vec::new(), Vec::new(), Vec::new(), Vec::new()];
+        for index in 0..30 {
+            let packet = receiver.next().await.unwrap();
+            let class = packet.peer_manager_header().unwrap().avian_traffic_class();
+            observed[usize::from(class - 1)].push(packet.payload()[0]);
+            if index == 14 {
+                assert_eq!(observed[3], vec![0]);
+            }
+        }
+        for (class, count) in [(1, 16), (2, 8), (3, 4), (4, 2)] {
+            assert_eq!(observed[class - 1], (0..count).collect::<Vec<u8>>());
+        }
+    }
+    #[tokio::test]
+    async fn avian_congestion_full_reliable_classes_do_not_block_shared_dispatch() {
+        let (sender, mut receiver) = queues();
+        for class in [1, 2] {
+            for sequence in 0..16 {
+                sender.send(packet(class, sequence)).await.unwrap();
+            }
+            let result =
+                tokio::time::timeout(Duration::from_millis(50), sender.send(packet(class, 16)))
+                    .await
+                    .expect("full queue admission must return without waiting");
+            assert!(matches!(result, Err(TunnelError::BufferFull)));
+        }
+        assert_eq!(
+            receiver
+                .next()
+                .await
+                .unwrap()
+                .peer_manager_header()
+                .unwrap()
+                .avian_traffic_class(),
+            1
+        );
+        sender.send(packet(1, 17)).await.unwrap();
+    }
+}
