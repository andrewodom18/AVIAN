+fn configure_priority_buffer(stream: &TcpStream) -> std::io::Result<()> {
+    if std::env::var("ET_PRIORITY_FORWARDING").as_deref() == Ok("1") {
+        // Bound kernel backlog so the application scheduler can affect wire latency.
+        socket2::SockRef::from(stream).set_send_buffer_size(8 * 1024)?;
+    }
