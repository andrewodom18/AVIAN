+    pub async fn add_local_listener(&mut self, url: url::Url) -> Result<(), Error> {
+        if (!cfg!(target_os = "android") && std::env::var_os("AVIAN_RPC_TOKEN_FILE").is_none())
+            || !matches!(url.scheme(), "tcp" | "udp")
+            || url.port().is_none_or(|port| port < 1024)
+        {
+            return Err(Error::InvalidUrl(
+                "local listener management requires authenticated private RPC".into(),
+            ));
+        }
+        let binding = crate::connector::parse_underlay_binding(&url)?.ok_or_else(|| {
+            Error::InvalidUrl("local listener requires an explicit source and interface".into())
+        })?;
+        let host = url
+            .host_str()
+            .unwrap_or("")
+            .trim_matches(['[', ']'])
+            .parse::<IpAddr>()
+            .map_err(|_| {
+                Error::InvalidUrl("local listener host must be its source address".into())
+            })?;
+        if host != binding.source {
+            return Err(Error::InvalidUrl(
+                "local listener host differs from its source".into(),
+            ));
+        }
+        if self
+            .local_listeners
+            .get(url.as_str())
+            .is_some_and(|task| !task.is_finished())
+        {
+            return Ok(());
+        }
+        let mut listener = create_listener_by_url(&url, Arc::clone(&self.global_ctx))?;
+        listener.listen().await?;
+        let running = listener.local_url();
+        self.global_ctx.add_running_listener(running.clone());
+        self.global_ctx
+            .issue_event(GlobalCtxEvent::ListenerAdded(running.clone()));
+        let peer_manager = self.peer_manager.clone();
+        let context = Arc::clone(&self.global_ctx);
+        let task = tokio::spawn(async move {
+            loop {
+                let tunnel = match listener.accept().await {
+                    Ok(tunnel) => tunnel,
+                    Err(_) => break,
+                };
+                let manager = peer_manager.clone();
+                tokio::spawn(async move {
+                    if let Some(manager) = manager.upgrade() {
+                        let _ = manager.handle_tunnel(tunnel).await;
                     }
                 });
             }
+            context.remove_running_listener(&running);
+        });
+        self.local_listeners.insert(url.to_string(), task);
+        Ok(())
+    }
+    pub async fn remove_local_listener(&mut self, url: &url::Url) -> Result<(), Error> {
+        if let Some(task) = self.local_listeners.remove(url.as_str()) {
+            task.abort();
+            let _ = task.await;
         }
+        self.global_ctx.remove_running_listener(url);
+        Ok(())
     }
 
