+++ b/easytier/src/managed_network.rs
@@ -0,0 +1,127 @@
+//! Scoped helper access for an unprivileged Linux engine. No host configuration is performed here.
+pub fn enabled() -> bool {
+    cfg!(target_os = "linux") && std::env::var_os("AVIAN_NETWORK_HELPER_SOCKET").is_some()
+}
+
+#[cfg(target_os = "linux")]
+mod linux {
+    use super::enabled;
+    use crate::{common::global_ctx::ArcGlobalCtx, tunnel::TunnelError};
+    use avian_network_helper::{NetworkStatus, SocketTransport, client::HelperClient};
+    use std::{
+        net::{IpAddr, SocketAddr},
+        os::fd::OwnedFd,
+        sync::{Arc, OnceLock},
+        time::Duration,
+    };
+    use tokio::sync::Semaphore;
+    fn failure() -> TunnelError {
+        TunnelError::InvalidAddr("managed network request rejected".into())
+    }
+    fn helper_failure(error: avian_network_helper::HelperError) -> TunnelError {
+        TunnelError::InvalidAddr(format!("managed network request rejected: {error}"))
+    }
+    fn client() -> Result<HelperClient, TunnelError> {
+        let path = std::env::var_os("AVIAN_NETWORK_HELPER_SOCKET").ok_or_else(failure)?;
+        HelperClient::new(std::path::Path::new(&path)).map_err(helper_failure)
+    }
+    async fn blocking<T: Send + 'static>(
+        operation: impl FnOnce() -> Result<T, TunnelError> + Send + 'static,
+    ) -> Result<T, TunnelError> {
+        static LIMIT: OnceLock<Arc<Semaphore>> = OnceLock::new();
+        let limit = Arc::clone(LIMIT.get_or_init(|| Arc::new(Semaphore::new(16))));
+        tokio::time::timeout(Duration::from_secs(4), async move {
+            let permit = limit.acquire_owned().await.map_err(|_| failure())?;
+            tokio::task::spawn_blocking(move || {
+                let _permit = permit;
+                operation()
+            })
+            .await
+            .map_err(|_| failure())?
+        })
+        .await
+        .map_err(|_| failure())?
+    }
+    pub async fn status() -> Result<NetworkStatus, TunnelError> {
+        blocking(|| client()?.status().map_err(helper_failure)).await
+    }
+    pub async fn validate_scope(global_ctx: &ArcGlobalCtx) -> Result<NetworkStatus, TunnelError> {
+        if !enabled()
+            || nix::unistd::geteuid().as_raw() == 0
+            || std::env::var_os("AVIAN_RPC_TOKEN_FILE").is_none()
+            || std::env::var("ET_REQUIRE_VERIFIED_MEMBERSHIP").as_deref() != Ok("1")
+        {
+            return Err(failure());
+        }
+        let status = status().await?;
+        let ipv4 = global_ctx.get_ipv4().ok_or_else(failure)?;
+        let flags = global_ctx.get_flags();
+        if !status.active
+            || status.node_id != global_ctx.config.get_inst_name()
+            || flags.dev_name != status.tun_name
+            || ipv4.address() != status.overlay_address
+            || ipv4.network_length() != status.overlay_network.prefix_len()
+            || ipv4.first_address() != status.overlay_network.network()
+            || global_ctx.get_ipv6().is_some()
+            || global_ctx.config.get_dhcp()
+            || global_ctx.config.get_netns().is_some()
+            || flags.no_tun
+            || flags.enable_exit_node
+            || !global_ctx.config.get_proxy_cidrs().is_empty()
+            || !global_ctx.config.get_exit_nodes().is_empty()
+            || global_ctx
+                .config
+                .get_routes()
+                .is_some_and(|routes| !routes.is_empty())
+            || global_ctx.config.get_ipv6_public_addr_auto()
+            || global_ctx.config.get_ipv6_public_addr_provider()
+        {
+            return Err(failure());
+        }
+        Ok(status)
+    }
+    pub async fn open_socket(
+        protocol: SocketTransport,
+        interface_name: String,
+        source_address: IpAddr,
+        destination: SocketAddr,
+    ) -> Result<OwnedFd, TunnelError> {
+        blocking(move || {
+            client()?
+                .open_socket(protocol, &interface_name, source_address, destination)
+                .map_err(helper_failure)
+        })
+        .await
+    }
+    pub async fn open_listener(
+        url: &url::Url,
+        protocol: SocketTransport,
+    ) -> Result<OwnedFd, TunnelError> {
+        let binding = crate::connector::parse_underlay_binding(url)
+            .map_err(|_| failure())?
+            .ok_or_else(failure)?;
+        let address = url
+            .host_str()
+            .unwrap_or("")
+            .trim_matches(['[', ']'])
+            .parse::<IpAddr>()
+            .map_err(|_| failure())?;
+        if address != binding.source {
+            return Err(failure());
+        }
+        let port = url.port().ok_or_else(failure)?;
+        blocking(move || {
+            let client = client()?;
+            let status = client.status().map_err(helper_failure)?;
+            if !status.active || status.listen_port != port {
+                return Err(failure());
+            }
+            client
+                .open_listener(protocol, &binding.interface_name, binding.source)
+                .map_err(helper_failure)
+        })
+        .await
+    }
+}
+#[cfg(target_os = "linux")]
+pub use linux::*;
