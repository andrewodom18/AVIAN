+        destination.version = 2;
+        let raw = make_raw(&destination);
+        service
+            .synced_route_info
+            .update_peer_infos(1, service.my_peer_route_id, 2, &[destination], &[raw])
+            .unwrap();
+        service.update_route_table();
+        assert_eq!(service.policy_tables.read().unwrap().get(&(1, 2)), Some(&2));
+    }
+}
