diff --git a/easytier/src/peers/topology_policy.rs b/easytier/src/peers/topology_policy.rs
new file mode 100644
index 0000000..0de95f1
--- /dev/null
+++ b/easytier/src/peers/topology_policy.rs
@@ -0,0 +1,146 @@
+//! Per-class routes calculated from authenticated, directed neighbor advertisements.
+use crate::{common::PeerId, proto::peer_rpc::RoutePeerInfo};
+use std::cmp::Reverse;
+use std::collections::{BTreeMap, BinaryHeap};
+
+pub(super) fn calculate(
+    source: PeerId,
+    records: Vec<RoutePeerInfo>,
+) -> BTreeMap<(u8, PeerId), PeerId> {
+    let records: BTreeMap<_, _> = records
+        .into_iter()
+        .map(|record| (record.peer_id, record))
+        .collect();
+    let mut routes = BTreeMap::new();
+    for class in 1..=4 {
+        let mut costs = BTreeMap::new();
+        let mut queue = BinaryHeap::new();
+        costs.insert(source, (0u64, source));
+        queue.push(Reverse((0u64, source, source)));
+        while let Some(Reverse((cost, first_hop, current))) = queue.pop() {
+            if costs.get(&current) != Some(&(cost, first_hop)) {
+                continue;
+            }
+            let Some(record) = records.get(&current) else {
+                continue;
+            };
+            if current != source
+                && record
+                    .feature_flag
+                    .is_some_and(|flags| flags.avoid_relay_data)
+            {
+                continue;
+            }
+            for edge in &record.avian_policy_edges {
+                if edge.allowed_classes & (1 << class) == 0
+                    || !records.contains_key(&edge.destination)
+                {
+                    continue;
+                }
+                let Some(next_cost) = cost.checked_add(if edge.latency_us == 0 {
+                    1_000_000
+                } else {
+                    edge.latency_us
+                }) else {
+                    continue;
+                };
+                let next_hop = if current == source {
+                    edge.destination
+                } else {
+                    first_hop
+                };
+                let candidate = (next_cost, next_hop);
+                if costs
+                    .get(&edge.destination)
+                    .is_none_or(|old| candidate < *old)
+                {
+                    costs.insert(edge.destination, candidate);
+                    queue.push(Reverse((next_cost, next_hop, edge.destination)));
+                }
+            }
+        }
+        for (destination, (_, next_hop)) in costs {
+            if destination != source {
+                routes.insert((class, destination), next_hop);
+            }
+        }
+    }
+    routes
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::proto::peer_rpc::AvianPolicyEdge;
+    fn node(id: u32, edges: &[(u32, u32, u64)]) -> RoutePeerInfo {
+        let mut record = RoutePeerInfo::new();
+        record.peer_id = id;
+        record.avian_policy_edges = edges
+            .iter()
+            .map(
+                |(destination, allowed_classes, latency_us)| AvianPolicyEdge {
+                    destination: *destination,
+                    allowed_classes: *allowed_classes,
+                    latency_us: *latency_us,
+                },
+            )
+            .collect();
+        record
+    }
+    #[test]
+    fn avian_topology_remote_restrictions_and_direct_bypass() {
+        let mut records = vec![
+            node(1, &[(2, 30, 1), (3, 30, 20), (4, 6, 1)]),
+            node(2, &[(4, 6, 1)]),
+            node(3, &[(4, 30, 20)]),
+            node(4, &[]),
+        ];
+        let routes = calculate(1, records.clone());
+        assert_eq!(routes.get(&(1, 4)), Some(&4));
+        assert_eq!(routes.get(&(3, 4)), Some(&3));
+        assert_eq!(routes.get(&(4, 4)), Some(&3));
+        records.retain(|record| record.peer_id != 3);
+        let routes = calculate(1, records);
+        assert_eq!(routes.get(&(1, 4)), Some(&4));
+        assert!(!routes.contains_key(&(3, 4)));
+    }
+    #[test]
+    fn avian_topology_unknown_metrics_and_cycles() {
+        let records = vec![
+            node(1, &[(2, 30, 0), (3, 30, 20)]),
+            node(2, &[(4, 30, 0)]),
+            node(3, &[(1, 30, 1), (4, 30, 20)]),
+            node(4, &[]),
+        ];
+        assert_eq!(calculate(1, records).get(&(3, 4)), Some(&3));
+    }
+}
+
+#[cfg(test)]
+mod parallel_link_tests {
+    use super::*;
+    use crate::proto::peer_rpc::AvianPolicyEdge;
+    #[test]
+    fn avian_topology_parallel_connection_cost_matches_class_eligibility() {
+        let record = |id, edges| {
+            let mut value = RoutePeerInfo::new();
+            value.peer_id = id;
+            value.avian_policy_edges = edges;
+            value
+        };
+        let edge = |destination, allowed_classes, latency_us| AvianPolicyEdge {
+            destination,
+            allowed_classes,
+            latency_us,
+        };
+        let records = vec![
+            record(1, vec![edge(2, 6, 1), edge(2, 30, 100), edge(3, 30, 20)]),
+            record(2, vec![edge(4, 30, 1)]),
+            record(3, vec![edge(4, 30, 20)]),
+            record(4, vec![]),
+        ];
+        let routes = calculate(1, records);
+        assert_eq!(routes.get(&(1, 4)), Some(&2));
+        assert_eq!(routes.get(&(3, 4)), Some(&3));
+    }
+}
