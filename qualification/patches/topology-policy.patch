+                    .unwrap()
+                    .set_avian_traffic_class(class);
+                if super::traffic_policy::permits_connection(&packet, info.tunnel.as_ref()) {
+                    allowed_classes |= 1 << class;
+                }
+            }
+            edges.push(crate::proto::peer_rpc::AvianPolicyEdge {
+                destination: self.peer_node_id,
+                allowed_classes,
+                latency_us,
+            });
+        }
+        edges.sort_by_key(|edge| (edge.allowed_classes, edge.latency_us));
+        edges
+    }
