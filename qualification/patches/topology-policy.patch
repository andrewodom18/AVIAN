+            .peer_infos
+            .write()
+            .insert(1, source);
+        service
+            .synced_route_info
+            .policy_received
+            .insert(1, Instant::now());
+        let mut destination = RoutePeerInfo::new();
+        destination.peer_id = 2;
+        destination.version = 1;
+        let make_raw = |record: &RoutePeerInfo| {
+            let mut raw = DynamicMessage::new(RoutePeerInfo::default().descriptor());
+            raw.transcode_from(record).unwrap();
