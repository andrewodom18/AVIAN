FROM rust:1.95-bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends protobuf-compiler libprotobuf-dev pkg-config libssl-dev mold clang \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /source
ENV CARGO_PROFILE_DEV_DEBUG=0
ENV CARGO_PROFILE_DEV_INCREMENTAL=false
CMD ["cargo", "build", "--locked", "-p", "easytier", "--bin", "easytier-core", "--no-default-features", "--features", "tun,aes-gcm"]
